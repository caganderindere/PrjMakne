@model IReadOnlyList<UserListItem>
@{
    ViewData["Title"] = "Kullanıcılar";
}
<div class="admin-card">
    <div class="admin-card-header">
        <span class="text-muted small"><strong>Yönetici:</strong> tüm yetkiler · <strong>Editör:</strong> ürün, blog, galeri ve içerik yönetimi</span>
        <a asp-action="Create" class="btn btn-brand"><i class="fa-solid fa-user-plus me-1"></i>Yeni Kullanıcı</a>
    </div>
    <div class="table-responsive">
        <table class="table admin-table">
            <thead><tr><th>Ad Soyad</th><th>E-posta</th><th>Rol</th><th>Durum</th><th>Kayıt</th><th></th></tr></thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-semibold">@user.FullName</td>
                        <td>@user.Email</td>
                        <td><span class="badge @(user.Role == Roles.Admin ? "bg-dark" : "bg-secondary")">@Roles.Name(user.Role)</span></td>
                        <td><span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">@(user.IsActive ? "Aktif" : "Pasif")</span></td>
                        <td class="small text-muted">@user.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td>
                            <div class="actions">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-pen"></i></a>
                                <form method="post" asp-action="Delete" asp-route-id="@user.Id" data-confirm="Bu kullanıcıyı silmek istediğinize emin misiniz?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
