@model IReadOnlyList<SimpleCategoryListItem>
<div class="admin-card" style="max-width:900px">
    <div class="admin-card-header">
        <span class="text-muted small">@Model.Count kategori</span>
        <a asp-action="Create" class="btn btn-brand"><i class="fa-solid fa-plus me-1"></i>Yeni Kategori</a>
    </div>
    <div class="table-responsive">
        <table class="table admin-table">
            <thead><tr><th>Ad</th><th>Sıra</th><th>Kayıt</th><th></th></tr></thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><a asp-action="Edit" asp-route-id="@item.Id" class="fw-semibold">@item.Name</a></td>
                        <td>@item.SortOrder</td>
                        <td>@item.ItemCount</td>
                        <td>
                            <div class="actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-pen"></i></a>
                                <form method="post" asp-action="Delete" asp-route-id="@item.Id" data-confirm="Bu kategoriyi silmek istediğinize emin misiniz?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
