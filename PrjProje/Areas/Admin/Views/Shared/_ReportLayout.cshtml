@inject PrjProje.Application.Interfaces.ISiteSettingsService SettingsService
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    // Shared letterhead for printable panel documents: logo top left, document type, number and date top right,
    // company address and slogan in the footer. The header and footer repeat on every printed page.
    var settings = await SettingsService.GetAsync();
    var reportTitle = ViewData["ReportTitle"] as string ?? "Belge";
    var documentNumber = ViewData["DocumentNumber"] as string;
    var documentDate = ViewData["DocumentDate"] as string;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>@(documentNumber ?? reportTitle) | PRJ Proje Makina</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/report.css" asp-append-version="true" />
</head>
<body class="report-body">
    <div class="report-toolbar">
        @await RenderSectionAsync("Toolbar", required: false)
        <button type="button" class="report-btn report-btn-primary" data-print><i class="fa-solid fa-print"></i>Yazdır / PDF</button>
    </div>
    <main class="report-sheet">
        <table class="report-frame">
            <thead>
                <tr>
                    <td>
                        <header class="report-header">
                            <img src="~/images/logo.png" alt="PRJ Proje Makina" class="report-logo" width="221" height="48" />
                            <div class="report-meta">
                                <div class="report-type">@reportTitle</div>
                                @if (documentNumber is not null)
                                {
                                    <div>Belge No: <strong>@documentNumber</strong></div>
                                }
                                @if (documentDate is not null)
                                {
                                    <div>Tarih: @documentDate</div>
                                }
                            </div>
                        </header>
                    </td>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <td>
                        <footer class="report-footer">
                            <div>
                                <strong>@settings.CompanyName</strong> · @settings.AddressTr
                                <br />@settings.Phone · @settings.Email
                            </div>
                            <div class="report-slogan">@L["Card.Tagline"]</div>
                        </footer>
                    </td>
                </tr>
            </tfoot>
            <tbody>
                <tr>
                    <td class="report-content">@RenderBody()</td>
                </tr>
            </tbody>
        </table>
    </main>
    <script src="~/js/report.js" asp-append-version="true"></script>
</body>
</html>
