@model QuoteRequestDto
@{
    ViewData["Title"] = $"Teklif Talebi #{Model.Id}";
    var update = new QuoteStatusUpdateModel { Id = Model.Id, Status = Model.Status, AdminNote = Model.AdminNote };
}
<div class="row g-4">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">@Model.CompanyName</h2>
                <span class="badge @AdminLabels.StatusBadge(Model.Status) fs-6">@AdminLabels.Status(Model.Status)</span>
            </div>
            <dl class="row detail-list">
                <div class="col-sm-6"><dt>Ürün</dt><dd>@(Model.ProductName ?? "-")</dd></div>
                <div class="col-sm-6"><dt>Miktar</dt><dd>@(Model.Quantity ?? "-")</dd></div>
            </dl>
            <h3 class="h6 text-uppercase text-muted">Açıklama</h3>
            <div class="message-body mb-3">@Model.Description</div>
            @if (Model.AttachmentOriginalName is not null)
            {
                <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-outline-dark">
                    <i class="fa-solid fa-download me-1"></i>@Model.AttachmentOriginalName
                    <span class="text-muted small ms-1">(@ViewHelpers.FileSize(Model.AttachmentSize ?? 0))</span>
                </a>
            }
        </div>
        <div class="admin-card">
            <h2 class="admin-card-title mb-3">Durum Güncelle</h2>
            <form method="post" asp-action="UpdateStatus">
                <input type="hidden" name="Id" value="@update.Id" />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="Status">Durum</label>
                        <select name="Status" id="Status" class="form-select">
                            @foreach (var value in Enum.GetValues<QuoteStatus>())
                            {
                                <option value="@value" selected="@(value == update.Status)">@AdminLabels.Status(value)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label" for="AdminNote">Yönetici Notu (dahili)</label>
                        <textarea name="AdminNote" id="AdminNote" class="form-control" rows="3" maxlength="2000">@update.AdminNote</textarea>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-brand"><i class="fa-solid fa-floppy-disk me-1"></i>Kaydet</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="admin-card">
            <dl class="detail-list mb-0">
                <dt>Ad Soyad</dt><dd>@Model.FullName</dd>
                <dt>Firma</dt><dd>@Model.CompanyName</dd>
                <dt>E-posta</dt><dd><a href="mailto:@Model.Email">@Model.Email</a></dd>
                <dt>Telefon</dt><dd><a href="tel:@Model.Phone">@Model.Phone</a></dd>
                <dt>Dil</dt><dd>@Languages.DisplayName(Model.LanguageCode)</dd>
                <dt>Talep Tarihi</dt><dd>@Model.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                <dt>Son Güncelleme</dt><dd>@(Model.UpdatedDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
                <dt>IP Adresi</dt><dd>@(Model.IpAddress ?? "-")</dd>
            </dl>
            <a href="mailto:@Model.Email?subject=@Uri.EscapeDataString($"PRJ Proje Makina - Teklif #{Model.Id}")" class="btn btn-dark w-100 mb-2"><i class="fa-solid fa-envelope me-1"></i>E-posta Gönder</a>
            <form method="post" asp-action="Delete" asp-route-id="@Model.Id" data-confirm="Bu teklif talebini silmek istediğinize emin misiniz?">
                <button type="submit" class="btn btn-outline-danger w-100"><i class="fa-solid fa-trash me-1"></i>Sil</button>
            </form>
        </div>
    </div>
</div>
