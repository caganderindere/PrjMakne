@model IReadOnlyList<GalleryAdminItem>
@{
    ViewData["Title"] = "Galeri";
    var categories = (IReadOnlyList<OptionItem>)ViewBag.Categories;
    var upload = (GalleryUploadModel)ViewBag.Upload;
    int? categoryId = ViewBag.CategoryId;
}
<div class="admin-card">
    <h2 class="admin-card-title mb-3">Fotoğraf Yükle</h2>
    <form method="post" asp-action="Upload" enctype="multipart/form-data" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="CategoryId">Kategori</label>
            <select name="CategoryId" id="CategoryId" class="form-select" required>
                <option value="">Seçiniz…</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id" selected="@(categoryId == category.Id)">@category.Name</option>
                }
            </select>
        </div>
        @for (var i = 0; i < upload.Titles.Count; i++)
        {
            <div class="col-md-3">
                <input type="hidden" name="Titles[@i].LanguageCode" value="@upload.Titles[i].LanguageCode" />
                <label class="form-label" for="title-@i"><span class="lang-badge">@upload.Titles[i].LanguageCode.ToUpperInvariant()</span> Başlık (isteğe bağlı)</label>
                <input type="text" name="Titles[@i].Title" id="title-@i" class="form-control" maxlength="200" />
            </div>
        }
        <div class="col-md-3">
            <label class="form-label" for="Files">Fotoğraflar</label>
            <input type="file" name="Files" id="Files" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" multiple required />
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-brand"><i class="fa-solid fa-cloud-arrow-up me-1"></i>Yükle</button>
            <span class="form-text ms-2">Birden fazla fotoğraf seçebilirsiniz. Fotoğraflar WebP'ye dönüştürülür.</span>
        </div>
    </form>
</div>

<div class="admin-card">
    <div class="admin-card-header">
        <form method="get" class="d-flex gap-2">
            <select name="categoryId" class="form-select" style="max-width:260px">
                <option value="">Tüm kategoriler</option>
                @foreach (var category in categories)
                {
                    <option value="@category.Id" selected="@(categoryId == category.Id)">@category.Name</option>
                }
            </select>
            <button type="submit" class="btn btn-dark"><i class="fa-solid fa-filter"></i></button>
        </form>
        <span class="text-muted small">@Model.Count fotoğraf</span>
    </div>

    @if (Model.Count == 0)
    {
        <p class="text-muted text-center py-5 mb-0">Bu kategoride fotoğraf yok.</p>
    }
    else
    {
        <form method="post" asp-action="Sort" asp-route-categoryId="@categoryId" id="sortForm"></form>
        <div class="image-grid">
            @for (var i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                <div class="image-grid-item @(item.IsActive ? null : "inactive")">
                    <img src="@ViewHelpers.SmallImage(item.ImagePath)" alt="@item.Title" loading="lazy" />
                    <div class="body">
                        <div class="small text-muted text-truncate">@item.CategoryName</div>
                        <div class="text-truncate fw-semibold mb-2" title="@item.Title">@(string.IsNullOrEmpty(item.Title) ? "—" : item.Title)</div>
                        <div class="d-flex gap-1 align-items-center">
                            <input type="hidden" name="items[@i].Id" value="@item.Id" form="sortForm" />
                            <input type="number" name="items[@i].SortOrder" value="@item.SortOrder" class="form-control form-control-sm" style="width:64px" title="Sıra" form="sortForm" />
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark ms-auto"><i class="fa-solid fa-pen"></i></a>
                            <form method="post" asp-action="Delete" asp-route-id="@item.Id" asp-route-categoryId="@categoryId" data-confirm="Bu fotoğrafı silmek istediğinize emin misiniz?">
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="mt-3 text-end">
            <button type="submit" form="sortForm" class="btn btn-dark"><i class="fa-solid fa-arrow-down-1-9 me-1"></i>Sıralamayı Kaydet</button>
        </div>
    }
</div>
