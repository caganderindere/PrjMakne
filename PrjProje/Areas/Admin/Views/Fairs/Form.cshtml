@using PrjProje.Web.Routing
@model FairEditModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Yeni Fuar" : "Fuar Düzenle";
    var path = isNew ? null : SiteRoutes.Path(SiteRoutes.Fair, Languages.Default, Model.Slug);
}
<form method="post" asp-action="Save" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="BrochurePdf" />
    <div asp-validation-summary="All" class="alert alert-danger small"></div>
    <div class="row g-4">
        <div class="col-xl-8">
            <div class="admin-card">
                <h2 class="admin-card-title mb-3">Fuar</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Name"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Slug" class="form-label"></label>
                        <input asp-for="Slug" class="form-control" placeholder="Boş bırakılırsa fuar adından oluşur" autocomplete="off" />
                        <div class="form-text">@(isNew ? "" : "Değiştirirseniz basılı QR kodlar çalışmaz; yeni QR kod gerekir.")</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TitleTr" class="form-label"><span class="lang-badge">TR</span> Başlık</label>
                        <input asp-for="TitleTr" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TitleEn" class="form-label"><span class="lang-badge">EN</span> Başlık</label>
                        <input asp-for="TitleEn" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="IntroTr" class="form-label"><span class="lang-badge">TR</span> Kısa Açıklama</label>
                        <textarea asp-for="IntroTr" class="form-control" rows="2" maxlength="400"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="IntroEn" class="form-label"><span class="lang-badge">EN</span> Kısa Açıklama</label>
                        <textarea asp-for="IntroEn" class="form-control" rows="2" maxlength="400"></textarea>
                    </div>
                    <div class="col-12 form-text mt-1">Başlık boşsa fuar adı gösterilir. İngilizce alanlar boşsa Türkçe metin kullanılır.</div>
                </div>
            </div>
            <div class="admin-card">
                <h2 class="admin-card-title mb-3">Broşür ve Bağlantılar</h2>
                <label asp-for="BrochureFile" class="form-label"></label>
                <input asp-for="BrochureFile" type="file" class="form-control" accept=".pdf" />
                <div class="form-text mb-3">
                    En fazla 20 MB.
                    @if (!string.IsNullOrEmpty(Model.BrochurePdf))
                    {
                        <a href="@Model.BrochurePdf" target="_blank" rel="noopener">Mevcut broşürü aç</a>
                    }
                </div>
                <label asp-for="ExtraLinks" class="form-label"></label>
                <textarea asp-for="ExtraLinks" class="form-control" rows="3" placeholder="Fuar özel kataloğu | https://www.prestijteknikmakine.com.tr/katalog"></textarea>
                <div class="form-text">Web sitesi ve sosyal medya hesapları Site Ayarlarından otomatik gelir. Buraya yalnızca fuara özel ek bağlantılar yazın: <code>Görünecek ad | adres</code></div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="admin-card">
                <h2 class="admin-card-title mb-3">Ziyaretçi Ayarları</h2>
                <div class="form-check form-switch">
                    <input asp-for="EmailRequired" class="form-check-input" />
                    <label asp-for="EmailRequired" class="form-check-label"></label>
                </div>
                <div class="form-text mb-3">Kapalıysa ziyaretçi “E-posta vermeden devam et” seçeneğini görür.</div>
                <div class="form-check form-switch">
                    <input asp-for="ShowMarketingConsent" class="form-check-input" />
                    <label asp-for="ShowMarketingConsent" class="form-check-label"></label>
                </div>
                <div class="form-text mb-3">Kutucuk işaretsiz gelir ve broşüre erişim şartı değildir. Kapalıysa tanıtım izni alınmaz.</div>
                <div class="form-check form-switch mb-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-brand w-100"><i class="fa-solid fa-floppy-disk me-1"></i>Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">İptal</a>
            </div>
            @if (path is not null)
            {
                <div class="admin-card">
                    <h2 class="admin-card-title mb-3">Bağlantı ve QR Kod</h2>
                    <div class="input-group input-group-sm">
                        <input class="form-control" value="@Url.Absolute(path)" readonly aria-label="Fuar bağlantısı" />
                        <button type="button" class="btn btn-outline-secondary" data-copy="@Url.Absolute(path)">Kopyala</button>
                    </div>
                    <img src="@Url.Action("QrPng", new { id = Model.Id })" alt="@Model.Name QR kodu" class="qr-large" />
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <a asp-action="QrPng" asp-route-id="@Model.Id" asp-route-download="true" class="btn btn-sm btn-outline-dark">PNG indir</a>
                        <a asp-action="QrSvg" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-dark">SVG (baskı)</a>
                        <a asp-action="Leads" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-dark">E-posta listesi</a>
                    </div>
                </div>
            }
        </div>
    </div>
</form>
