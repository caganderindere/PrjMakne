@model FairLeadsModel
@{
    ViewData["Title"] = $"{Model.FairName} E-postaları";
}
<div class="admin-card">
    <div class="admin-card-header">
        <span class="text-muted small">@Model.Leads.Count e-posta, @Model.Leads.Count(l => l.MarketingConsent) tanıtım izni. Tanıtım maillerini yalnızca izin verenlere gönderin.</span>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Fuarlar</a>
            <a asp-action="LeadsCsv" asp-route-id="@Model.FairId" class="btn btn-brand"><i class="fa-solid fa-file-csv me-1"></i>CSV indir</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table admin-table">
            <thead><tr><th>E-posta</th><th>Tanıtım izni</th><th>İzin tarihi</th><th>Dil</th><th>Kayıt tarihi</th><th></th></tr></thead>
            <tbody>
                @foreach (var lead in Model.Leads)
                {
                    <tr>
                        <td>@lead.Email</td>
                        <td><span class="badge @(lead.MarketingConsent ? "bg-success" : "bg-secondary")">@(lead.MarketingConsent ? "Var" : "Yok")</span></td>
                        <td>@lead.MarketingConsentDate?.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@lead.LanguageCode.ToUpperInvariant()</td>
                        <td>@lead.CreatedDate?.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <div class="actions">
                                <form method="post" asp-action="DeleteLead" asp-route-id="@lead.Id" asp-route-fairId="@Model.FairId" data-confirm="@lead.Email silinsin mi?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Leads.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">Henüz e-posta toplanmadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
