@model VideoEditModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Yeni Video" : "Video Düzenle";
}
<div class="admin-card" style="max-width:900px">
    <form method="post" asp-action="Save">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="alert alert-danger small"></div>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="Url" class="form-label"></label>
                <input asp-for="Url" class="form-control" placeholder="https://www.youtube.com/watch?v=..." />
                <div class="form-text">watch, youtu.be, shorts veya embed bağlantısı olabilir.</div>
                <span asp-validation-for="Url"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="TitleTr" class="form-label"></label>
                <input asp-for="TitleTr" class="form-control" />
                <span asp-validation-for="TitleTr"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="TitleEn" class="form-label"></label>
                <input asp-for="TitleEn" class="form-control" />
                <span asp-validation-for="TitleEn"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="SortOrder" class="form-label"></label>
                <input asp-for="SortOrder" class="form-control" />
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-brand"><i class="fa-solid fa-floppy-disk me-1"></i>Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
            </div>
        </div>
    </form>
</div>
