@model IReadOnlyList<VideoAdminItem>
@{
    ViewData["Title"] = "Videolar";
}
<div class="admin-card">
    <div class="admin-card-header">
        <span class="text-muted small">Videolar YouTube'dan gömülür; sitede yalnızca tıklanınca yüklenir.</span>
        <a asp-action="Create" class="btn btn-brand"><i class="fa-solid fa-plus me-1"></i>Yeni Video</a>
    </div>
    <div class="table-responsive">
        <table class="table admin-table">
            <thead><tr><th></th><th>Başlık</th><th>Sıra</th><th>Durum</th><th></th></tr></thead>
            <tbody>
                @foreach (var video in Model)
                {
                    <tr>
                        <td><img src="https://i.ytimg.com/vi/@video.YouTubeId/mqdefault.jpg" alt="" width="96" height="54" loading="lazy" /></td>
                        <td><a asp-action="Edit" asp-route-id="@video.Id" class="fw-semibold">@video.TitleTr</a><div class="small text-muted">@(video.TitleEn ?? "-")</div></td>
                        <td>@video.SortOrder</td>
                        <td>@(video.IsActive ? "Yayında" : "Gizli")</td>
                        <td>
                            <div class="actions">
                                <a asp-action="Edit" asp-route-id="@video.Id" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-pen"></i></a>
                                <form method="post" asp-action="Delete" asp-route-id="@video.Id" data-confirm="Bu videoyu silmek istediğinize emin misiniz?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">Henüz video yok.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
