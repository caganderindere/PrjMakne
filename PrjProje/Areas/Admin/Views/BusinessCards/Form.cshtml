@using PrjProje.Web.Routing
@model BusinessCardEditModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Yeni Kartvizit" : "Kartvizit Düzenle";
    var path = isNew ? null : SiteRoutes.Path(SiteRoutes.BusinessCard, Languages.Default, Model.Slug);
}
<form method="post" asp-action="Save" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Photo" />
    <input type="hidden" asp-for="Views" />
    @* Only redisplays the link after a failed save; the server never reads it back. *@
    <input type="hidden" asp-for="Slug" />
    <div asp-validation-summary="All" class="alert alert-danger small"></div>
    <div class="row g-4">
        <div class="col-xl-8">
            <div class="admin-card">
                <h2 class="admin-card-title mb-3">Kişi</h2>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" autocomplete="off" />
                        <span asp-validation-for="FirstName"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" autocomplete="off" />
                        <span asp-validation-for="LastName"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TitleTr" class="form-label"><span class="lang-badge">TR</span> Unvan</label>
                        <input asp-for="TitleTr" class="form-control" placeholder="Satış Müdürü" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TitleEn" class="form-label"><span class="lang-badge">EN</span> Unvan</label>
                        <input asp-for="TitleEn" class="form-control" placeholder="Sales Manager" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DepartmentTr" class="form-label"><span class="lang-badge">TR</span> Departman</label>
                        <input asp-for="DepartmentTr" class="form-control" placeholder="İhracat" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DepartmentEn" class="form-label"><span class="lang-badge">EN</span> Departman</label>
                        <input asp-for="DepartmentEn" class="form-control" placeholder="Export" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NoteTr" class="form-label"><span class="lang-badge">TR</span> Kısa Not</label>
                        <textarea asp-for="NoteTr" class="form-control" rows="2" maxlength="400"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NoteEn" class="form-label"><span class="lang-badge">EN</span> Kısa Not</label>
                        <textarea asp-for="NoteEn" class="form-control" rows="2" maxlength="400"></textarea>
                    </div>
                    <div class="col-12 form-text mt-1">İngilizce alanlar boş bırakılırsa İngilizce sayfada Türkçe metin gösterilir.</div>
                </div>
            </div>
            <div class="admin-card">
                <h2 class="admin-card-title mb-3">İletişim ve Bağlantılar</h2>
                <p class="small text-muted">Boş bırakılan alanlar kartvizitte görünmez. Numaraları 0532 123 45 67 veya +90 532 ... biçiminde yazabilirsiniz.</p>
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="Mobile" class="form-label"></label><input asp-for="Mobile" class="form-control" type="tel" placeholder="0532 123 45 67" /></div>
                    <div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" type="tel" placeholder="0312 000 00 00" /></div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="ad.soyad@prestijteknikmakine.com.tr" />
                        <span asp-validation-for="Email"></span>
                    </div>
                    <div class="col-md-6"><label asp-for="LinkedIn" class="form-label"></label><input asp-for="LinkedIn" class="form-control" placeholder="linkedin.com/in/kullanici veya kullanıcı adı" /></div>
                    <div class="col-md-6"><label asp-for="Instagram" class="form-label"></label><input asp-for="Instagram" class="form-control" placeholder="Kullanıcı adı veya profil bağlantısı" /></div>
                    <div class="col-12"><label asp-for="Website" class="form-label"></label><input asp-for="Website" class="form-control" placeholder="https://www.prestijteknikmakine.com.tr" /></div>
                    <div class="col-12">
                        <label asp-for="ExtraLinks" class="form-label"></label>
                        <textarea asp-for="ExtraLinks" class="form-control" rows="4" placeholder="Ürün kataloğu | https://www.prestijteknikmakine.com.tr/katalog.pdf&#10;YouTube | youtube.com/kanal"></textarea>
                        <div class="form-text">Her satıra bir bağlantı: <code>Görünecek ad | adres</code></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-4">
            <div class="admin-card">
                <h2 class="admin-card-title mb-3">Yayın</h2>
                <div class="form-check form-switch mb-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
                <label asp-for="SortOrder" class="form-label"></label>
                <input asp-for="SortOrder" class="form-control mb-3" type="number" />
                <button type="submit" class="btn btn-brand w-100"><i class="fa-solid fa-floppy-disk me-1"></i>Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2">İptal</a>
            </div>
            @if (path is not null)
            {
                <div class="admin-card">
                    <h2 class="admin-card-title mb-3">Bağlantı ve QR Kod</h2>
                    <div class="input-group input-group-sm">
                        <input class="form-control" value="@Url.Absolute(path)" readonly aria-label="Kartvizit bağlantısı" />
                        <button type="button" class="btn btn-outline-secondary" data-copy="@Url.Absolute(path)">Kopyala</button>
                    </div>
                    <img src="@Url.Action("QrPng", new { id = Model.Id })" alt="@Model.FirstName @Model.LastName QR kodu" class="qr-large" />
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <a asp-action="QrPng" asp-route-id="@Model.Id" asp-route-download="true" class="btn btn-sm btn-outline-dark">PNG indir</a>
                        <a asp-action="QrSvg" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-dark">SVG (baskı)</a>
                        @if (Model.IsActive)
                        {
                            <a href="@path" target="_blank" rel="noopener" class="btn btn-sm btn-outline-dark">Aç <i class="fa-solid fa-arrow-up-right-from-square ms-1"></i></a>
                        }
                    </div>
                    <p class="form-text text-center mt-3 mb-0">@Model.Views kez görüntülendi. Matbaa için SVG dosyasını kullanın.</p>
                    <p class="form-text mt-3 mb-0">Bağlantı rastgele bir anahtardır; internette bulunamaz ve tahmin edilemez, sayfa yalnızca QR okutularak açılır. Bağlantıyı kimseyle paylaşmayın.</p>
                    <div class="form-check mt-2">
                        <input asp-for="RegenerateLink" class="form-check-input" />
                        <label asp-for="RegenerateLink" class="form-check-label"></label>
                        <div class="form-text">Kart kaybolduysa ya da bağlantı başkasına geçtiyse işaretleyip kaydedin. Eski QR kod hemen çalışmaz olur, yeni kart bastırmak gerekir.</div>
                    </div>
                </div>
            }
            <div class="admin-card">
                <label asp-for="PhotoFile" class="form-label admin-card-title"></label>
                <img id="cardPreview" src="@(Model.Photo is null ? null : ViewHelpers.SmallImage(Model.Photo))" class="image-preview" alt="" hidden="@(Model.Photo is null)" />
                <input asp-for="PhotoFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" data-preview="cardPreview" />
                <div class="form-text">Kare fotoğraf önerilir; rehbere kaydedilen kişiye de eklenir.</div>
                @if (Model.Photo is not null)
                {
                    <div class="form-check mt-2">
                        <input asp-for="RemovePhoto" class="form-check-input" />
                        <label asp-for="RemovePhoto" class="form-check-label">Fotoğrafı kaldır</label>
                    </div>
                }
            </div>
        </div>
    </div>
</form>
