@model MeetingMinuteDto
@{
    Layout = "_ReportLayout";
    ViewData["ReportTitle"] = "Toplantı Tutanağı";
    ViewData["DocumentNumber"] = Model.Number;
    ViewData["DocumentDate"] = Model.MeetingDate.ToString("dd.MM.yyyy");
    var participants = Model.ParticipantUsers.Concat(MeetingMinuteDto.Lines(Model.Participants)).ToList();
    var agenda = MeetingMinuteDto.Lines(Model.Agenda);
    var decisions = MeetingMinuteDto.Lines(Model.Decisions);
}
@section Toolbar {
    <a asp-action="Index" class="report-btn"><i class="fa-solid fa-arrow-left"></i>Tutanaklar</a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="report-btn"><i class="fa-solid fa-pen"></i>Düzenle</a>
}
<h1 class="report-title">@Model.Title</h1>
<dl class="report-facts">
    <dt>Tarih / Saat</dt>
    <dd>@Model.MeetingDate.ToString("dd.MM.yyyy HH:mm")</dd>
    @if (Model.Location is not null)
    {
        <dt>Yer</dt>
        <dd>@Model.Location</dd>
    }
    <dt>Hazırlayan</dt>
    <dd>@Model.PreparedBy</dd>
    @if (Model.UpdatedDate is not null)
    {
        <dt>Son güncelleme</dt>
        <dd>@Model.UpdatedDate.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
    }
</dl>

@if (participants.Count > 0)
{
    <section class="report-section">
        <h2>Katılımcılar</h2>
        <ul class="report-inline">
            @foreach (var participant in participants)
            {
                <li>@participant</li>
            }
        </ul>
    </section>
}
@if (agenda.Count > 0)
{
    <section class="report-section">
        <h2>Gündem</h2>
        <ol>
            @foreach (var item in agenda)
            {
                <li>@item</li>
            }
        </ol>
    </section>
}

<section class="report-section">
    <h2>Alınan Kararlar</h2>
    <ol class="report-decisions">
        @foreach (var decision in decisions)
        {
            <li>@decision</li>
        }
    </ol>
</section>

@if (Model.Notes is not null)
{
    <section class="report-section">
        <h2>Notlar</h2>
        <div class="report-text">@Model.Notes</div>
    </section>
}

<div class="report-signatures">
    <div>
        <div class="report-signature"></div>
        <div class="report-signature-label">Hazırlayan: @Model.PreparedBy</div>
    </div>
    <div>
        <div class="report-signature"></div>
        <div class="report-signature-label">Onaylayan</div>
    </div>
</div>
@* Our own SVG markup, generated from the record's address. *@
<div class="report-verify">
    <div class="report-qr">@Html.Raw((string)ViewBag.QrSvg)</div>
    <div>Belgenin aslını görmek için kodu okutun (yönetim paneli girişi gerekir). Basılı nüshadaki bilgiler panelde <strong>@Model.Number</strong> kaydıyla aynı olmalıdır.</div>
</div>
