@model MeetingMinuteEditModel
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Yeni Toplantı Tutanağı" : $"Tutanak {Model.Number}";
    var users = (IReadOnlyList<UserOption>)ViewBag.Users;
    // The picker matches what was typed against these labels, so two people with the same name are told apart by e-mail.
    var duplicateNames = users.GroupBy(u => u.FullName).Where(g => g.Count() > 1).Select(g => g.Key).ToHashSet();
    string Label(UserOption user) => duplicateNames.Contains(user.FullName) ? $"{user.FullName} ({user.Email})" : user.FullName;
}
<div class="admin-card" style="max-width:900px">
    <form method="post" asp-action="Save">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
        <p class="text-muted small mb-4">
            @if (isNew)
            {
                <span>Belge numarası kaydedince otomatik verilir. Kaydettiğinizde antetli tutanak açılır, oradan yazdırabilirsiniz.</span>
            }
            else
            {
                <span>Belge No: <strong>@Model.Number</strong>. Kaydedince güncel tutanak açılır.</span>
            }
        </p>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" placeholder="Ör. Haftalık üretim planlama toplantısı" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="MeetingDate" class="form-label"></label>
                <input asp-for="MeetingDate" type="datetime-local" class="form-control" />
                <span asp-validation-for="MeetingDate" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" placeholder="Ör. Toplantı salonu / Online" />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>
            <div class="col-md-6"></div>
            <div class="col-12" data-participant-picker>
                <label for="participantPicker" class="form-label">Katılımcılar (panel kullanıcıları)</label>
                <div class="input-group input-group-sm mb-2" style="max-width:520px">
                    <input type="text" id="participantPicker" class="form-control" list="panelUsers" autocomplete="off" placeholder="İsim yazın, listeden seçin" />
                    <button type="button" class="btn btn-outline-dark" data-picker-add><i class="fa-solid fa-plus me-1"></i>Ekle</button>
                </div>
                <datalist id="panelUsers">
                    @foreach (var user in users)
                    {
                        <option value="@Label(user)" data-id="@user.Id"></option>
                    }
                </datalist>
                <div class="d-flex flex-wrap gap-2" data-picker-chips aria-live="polite">
                    @foreach (var user in users.Where(u => Model.ParticipantUserIds.Contains(u.Id)))
                    {
                        <span class="badge rounded-pill bg-light text-dark border d-inline-flex align-items-center gap-1 fw-normal fs-6" data-chip>
                            <input type="hidden" name="ParticipantUserIds" value="@user.Id" />@user.FullName
                            <button type="button" class="btn-close btn-close-sm ms-1" style="font-size:.6rem" aria-label="@user.FullName çıkar" data-chip-remove></button>
                        </span>
                    }
                </div>
                <div class="form-text">Tutanağı yalnızca buradaki kişiler ve hazırlayan görebilir.</div>
            </div>
            <div class="col-md-6">
                <label asp-for="Participants" class="form-label"></label>
                <div class="input-group input-group-sm mb-2">
                    <input type="text" class="form-control" list="participantSuggestions" placeholder="İsim yazın ve Enter'a basın" aria-label="Diğer katılımcı ekle" data-append-line="#Participants" />
                    <button type="button" class="btn btn-outline-dark" data-append-line-button><i class="fa-solid fa-plus me-1"></i>Ekle</button>
                </div>
                <datalist id="participantSuggestions">
                    @foreach (var name in (IReadOnlyList<string>)ViewBag.ParticipantSuggestions)
                    {
                        <option value="@name"></option>
                    }
                </datalist>
                <textarea asp-for="Participants" class="form-control" rows="5" placeholder="Ad Soyad – Birim"></textarea>
                <div class="form-text">Tutanakta görünürler, ama tutanağı açamazlar.</div>
                <span asp-validation-for="Participants" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Agenda" class="form-label"></label>
                <textarea asp-for="Agenda" class="form-control" rows="6"></textarea>
                <span asp-validation-for="Agenda" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Decisions" class="form-label"></label>
                <textarea asp-for="Decisions" class="form-control" rows="8" placeholder="Ör. Kalıp revizyonu 28.11.2026'ya kadar tamamlanacak (Sorumlu: Ar-Ge)"></textarea>
                <div class="form-text">Her satır tutanakta numaralı bir karar olur. Sorumlu ve tarihi kararın içine yazabilirsiniz.</div>
                <span asp-validation-for="Decisions" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-brand"><i class="fa-solid fa-file-lines me-1"></i>Kaydet ve Tutanağı Oluştur</button>
                <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
            </div>
        </div>
    </form>
</div>
