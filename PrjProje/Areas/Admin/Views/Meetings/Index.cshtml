@model PagedResult<MeetingMinuteListItem>
@{
    ViewData["Title"] = "Toplantı Tutanakları";
    var search = ViewBag.Search as string;
    var pager = (Model.Page, Model.TotalPages, (Func<int, string>)(p => Url.Action("Index", new { q = search, page = p })!));
}
<div class="admin-card">
    <div class="admin-card-header">
        <form method="get" class="d-flex gap-2">
            <input type="search" name="q" value="@search" class="form-control form-control-sm" placeholder="Belge no, konu, karar veya katılımcı ara" aria-label="Tutanak ara" style="min-width:260px" />
            <button type="submit" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>
        <a asp-action="Create" class="btn btn-brand"><i class="fa-solid fa-plus me-1"></i>Yeni Tutanak</a>
    </div>
    <div class="table-responsive">
        <table class="table admin-table">
            <thead><tr><th>Belge No</th><th>Konu</th><th>Tarih</th><th>Yer</th><th>Hazırlayan</th><th></th></tr></thead>
            <tbody>
                @foreach (var minute in Model.Items)
                {
                    <tr>
                        <td class="text-nowrap"><a asp-action="Print" asp-route-id="@minute.Id" class="fw-semibold">@minute.Number</a></td>
                        <td>@minute.Title</td>
                        <td class="small text-nowrap">@minute.MeetingDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="small">@(minute.Location ?? "-")</td>
                        <td class="small">@minute.PreparedBy</td>
                        <td>
                            <div class="actions">
                                <a asp-action="Print" asp-route-id="@minute.Id" class="btn btn-sm btn-outline-dark" title="Görüntüle / Yazdır"><i class="fa-solid fa-print"></i></a>
                                <a asp-action="Edit" asp-route-id="@minute.Id" class="btn btn-sm btn-outline-dark" title="Düzenle"><i class="fa-solid fa-pen"></i></a>
                                <form method="post" asp-action="Delete" asp-route-id="@minute.Id" data-confirm="@minute.Number numaralı tutanağı silmek istediğinize emin misiniz?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">@(string.IsNullOrEmpty(search) ? "Görebileceğiniz tutanak yok. Yalnızca hazırladığınız ve katılımcı olarak eklendiğiniz tutanaklar listelenir." : "Aramaya uyan tutanak bulunamadı.")</td></tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_AdminPager" model="pager" />
</div>
