@model TicketDetail
@{
    ViewData["Title"] = $"Bildirim #{Model.Id}";
    var isAdmin = Roles.HasFullAccess(User);
}
<div class="row g-4">
    <div class="col-lg-8">
        <div class="admin-card">
            <div class="admin-card-header">
                <h2 class="admin-card-title">@Model.Title</h2>
                <span class="badge @AdminLabels.StatusBadge(Model.Status) fs-6">@AdminLabels.Status(Model.Status)</span>
            </div>
            <div class="message-body mb-3">@Model.Description</div>
            @if (Model.AttachmentOriginalName is not null)
            {
                <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-outline-dark">
                    <i class="fa-solid fa-download me-1"></i>@Model.AttachmentOriginalName
                    <span class="text-muted small ms-1">(@ViewHelpers.FileSize(Model.AttachmentSize ?? 0))</span>
                </a>
            }
        </div>
        @if (isAdmin)
        {
            <div class="admin-card">
                <h2 class="admin-card-title mb-3">Durum Güncelle</h2>
                <form method="post" asp-action="Update">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label" for="Status">Durum</label>
                            <select name="Status" id="Status" class="form-select">
                                @foreach (var value in Enum.GetValues<TicketStatus>())
                                {
                                    <option value="@value" selected="@(value == Model.Status)">@AdminLabels.Status(value)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label" for="DeveloperNote">Geliştirici Notu (yalnızca yöneticiler görür)</label>
                            <textarea name="DeveloperNote" id="DeveloperNote" class="form-control" rows="3" maxlength="2000">@Model.DeveloperNote</textarea>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-brand"><i class="fa-solid fa-floppy-disk me-1"></i>Kaydet</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
                        </div>
                    </div>
                </form>
            </div>
        }
        else
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
        }
    </div>
    <div class="col-lg-4">
        <div class="admin-card">
            <dl class="detail-list mb-0">
                <dt>Tür</dt><dd><i class="fa-solid @AdminLabels.KindIcon(Model.Type) me-1" aria-hidden="true"></i>@AdminLabels.Kind(Model.Type)</dd>
                <dt>Önem</dt><dd><span class="badge @AdminLabels.PriorityBadge(Model.Priority)">@AdminLabels.Priority(Model.Priority)</span></dd>
                <dt>Gönderen</dt><dd>@Model.CreatedByName</dd>
                <dt>Tarih</dt><dd>@Model.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                <dt>Son Güncelleme</dt><dd>@(Model.UpdatedDate?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "-")</dd>
            </dl>
            @if (isAdmin)
            {
                <form method="post" asp-action="Delete" asp-route-id="@Model.Id" class="mt-3" data-confirm="Bu bildirimi ve ekini silmek istediğinize emin misiniz?">
                    <button type="submit" class="btn btn-outline-danger w-100"><i class="fa-solid fa-trash me-1"></i>Sil</button>
                </form>
            }
        </div>
    </div>
</div>
