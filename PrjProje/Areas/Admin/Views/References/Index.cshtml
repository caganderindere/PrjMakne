@model IReadOnlyList<ReferenceAdminItem>
@{
    ViewData["Title"] = "Referanslar";
}
<div class="admin-card">
    <div class="admin-card-header">
        <span class="text-muted small">Ana sayfadaki "Referanslarımız" bölümünde, sıra numarasına göre listelenir.</span>
        <a asp-action="Create" class="btn btn-brand"><i class="fa-solid fa-plus me-1"></i>Yeni Referans</a>
    </div>
    <div class="table-responsive">
        <table class="table admin-table">
            <thead><tr><th>Logo</th><th>Firma / Kurum</th><th>Web Sitesi</th><th>Sıra</th><th>Durum</th><th></th></tr></thead>
            <tbody>
                @foreach (var reference in Model)
                {
                    <tr>
                        <td><span class="reference-thumb"><img src="@reference.Logo" alt="" loading="lazy" /></span></td>
                        <td><a asp-action="Edit" asp-route-id="@reference.Id" class="fw-semibold">@reference.Name</a></td>
                        <td class="small">@if (reference.WebsiteUrl is not null) { <a href="@reference.WebsiteUrl" target="_blank" rel="noopener">@reference.WebsiteUrl</a> } else { <span class="text-muted">-</span> }</td>
                        <td>@reference.SortOrder</td>
                        <td><span class="badge @(reference.IsActive ? "bg-success" : "bg-secondary")">@(reference.IsActive ? "Yayında" : "Gizli")</span></td>
                        <td>
                            <div class="actions">
                                <a asp-action="Edit" asp-route-id="@reference.Id" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-pen"></i></a>
                                <form method="post" asp-action="Delete" asp-route-id="@reference.Id" data-confirm="Bu referansı silmek istediğinize emin misiniz?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">Henüz referans eklenmedi. Referans yoksa ana sayfadaki bölüm gizlenir.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
