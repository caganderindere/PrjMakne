@model SiteSettingsDto
@{
    ViewData["Title"] = "Site Ayarları";
}
<form method="post" asp-action="Index" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="alert alert-danger small"></div>
    <div class="row g-4">
        <div class="col-xl-6">
            <div class="admin-card">
                <h2 class="admin-card-title mb-3">İletişim Bilgileri</h2>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label" asp-for="CompanyName">Firma Adı</label><input asp-for="CompanyName" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label" asp-for="Phone">Telefon</label><input asp-for="Phone" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label" asp-for="Email">E-posta</label><input asp-for="Email" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label" asp-for="SalesEmail">Satış E-postası</label><input asp-for="SalesEmail" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label" asp-for="Fax">Faks</label><input asp-for="Fax" class="form-control" /></div>
                    <div class="col-12"><label class="form-label" asp-for="AddressTr"><span class="lang-badge">TR</span> Adres</label><input asp-for="AddressTr" class="form-control" /></div>
                    <div class="col-12"><label class="form-label" asp-for="AddressEn"><span class="lang-badge">EN</span> Adres</label><input asp-for="AddressEn" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label" asp-for="WorkingHoursTr"><span class="lang-badge">TR</span> Çalışma Saatleri</label><input asp-for="WorkingHoursTr" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label" asp-for="WorkingHoursEn"><span class="lang-badge">EN</span> Çalışma Saatleri</label><input asp-for="WorkingHoursEn" class="form-control" /></div>
                    <div class="col-12">
                        <label class="form-label" asp-for="MapEmbedUrl">Google Maps Embed URL</label>
                        <input asp-for="MapEmbedUrl" class="form-control" placeholder="https://www.google.com/maps/embed?pb=..." />
                        <span asp-validation-for="MapEmbedUrl"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="admin-card">
                <h2 class="admin-card-title mb-3">Sosyal Medya</h2>
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label" asp-for="LinkedInUrl">LinkedIn</label><input asp-for="LinkedInUrl" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label" asp-for="InstagramUrl">Instagram</label><input asp-for="InstagramUrl" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label" asp-for="FacebookUrl">Facebook</label><input asp-for="FacebookUrl" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label" asp-for="YouTubeUrl">YouTube</label><input asp-for="YouTubeUrl" class="form-control" /></div>
                    <div class="col-md-6"><label class="form-label" asp-for="XUrl">X (Twitter)</label><input asp-for="XUrl" class="form-control" /></div>
                </div>
            </div>
            <div class="admin-card">
                <h2 class="admin-card-title mb-3"><i class="fa-brands fa-whatsapp me-1"></i>WhatsApp Butonu</h2>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" asp-for="WhatsApp">Pazarlama Sorumlusunun Numarası</label>
                        <input asp-for="WhatsApp" class="form-control" placeholder="+90 5xx xxx xx xx" />
                        <div class="form-text">Sitenin sağ altındaki WhatsApp butonu bu numaraya yazar. Ülke koduyla girin. Boş bırakılırsa buton görünmez.</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="WhatsAppMessageTr"><span class="lang-badge">TR</span> Hazır Mesaj</label>
                        <textarea asp-for="WhatsAppMessageTr" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="WhatsAppMessageEn"><span class="lang-badge">EN</span> Hazır Mesaj</label>
                        <textarea asp-for="WhatsAppMessageEn" class="form-control" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="col-12 form-text mt-0">Ziyaretçi sitenin Türkçe sürümündeyse TR, İngilizce sürümündeyse EN mesajla sohbet açılır; ziyaretçi göndermeden önce mesajı değiştirebilir.</div>
                </div>
            </div>
            <div class="admin-card">
                <h2 class="admin-card-title mb-3">Ana Sayfa ve SEO</h2>
                <label class="form-label" for="heroImageFile">Hero Görseli (fabrika / üretim fotoğrafı, en az 1920px genişlik önerilir)</label>
                @if (!string.IsNullOrEmpty(Model.HeroImage))
                {
                    <img src="@ViewHelpers.SmallImage(Model.HeroImage)" class="image-preview" alt="" />
                    <div class="form-check mb-2">
                        <input type="checkbox" name="removeHeroImage" value="true" id="removeHeroImage" class="form-check-input" />
                        <label class="form-check-label" for="removeHeroImage">Görseli kaldır</label>
                    </div>
                }
                <input type="file" name="heroImageFile" id="heroImageFile" class="form-control mb-3" accept=".jpg,.jpeg,.png,.webp" />
                <label class="form-label" asp-for="HeroVideo">Masaüstü Hero Videosu (MP4)</label>
                <input asp-for="HeroVideo" class="form-control mb-1" placeholder="/videos/hero.mp4" />
                <div class="form-text mb-3">Boş bırakılırsa masaüstünde fotoğraf gösterilir.</div>
                <div class="row g-3 mb-1">
                    <div class="col-md-6">
                        <label class="form-label" asp-for="FoundedYear">Kuruluş Yılı</label>
                        <input asp-for="FoundedYear" class="form-control" inputmode="numeric" maxlength="4" placeholder="ör. 2005" />
                        <span asp-validation-for="FoundedYear" class="text-danger small d-block"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" asp-for="CompletedProjects">Tamamlanan Proje Sayısı</label>
                        <input asp-for="CompletedProjects" class="form-control" inputmode="numeric" maxlength="6" placeholder="ör. 250" />
                        <span asp-validation-for="CompletedProjects" class="text-danger small d-block"></span>
                    </div>
                </div>
                <div class="form-text mb-3">Hero altındaki sayaçlarda "yıllık deneyim" ve "tamamlanan proje" olarak gösterilir. Boş bırakılan sayaç gizlenir; ürün, hizmet ve sektör sayıları otomatik hesaplanır.</div>
                <label class="form-label" asp-for="GoogleSiteVerification">Google Search Console doğrulama kodu</label>
                <input asp-for="GoogleSiteVerification" class="form-control mb-3" />
                <label class="form-label" asp-for="GoogleAnalyticsId">Google Analytics 4 ölçüm kimliği</label>
                <input asp-for="GoogleAnalyticsId" class="form-control mb-1" placeholder="G-XXXXXXXXXX" />
                <span asp-validation-for="GoogleAnalyticsId" class="text-danger small d-block"></span>
                <div class="form-text mb-3">Analytics → Yönetici → Veri akışları → Web akışı'nda yazar. Ziyaretçi çerezleri kabul ederse yüklenir. Boş bırakılırsa takip kapalı.</div>
                <div class="form-text mt-2">Hero başlığı, slogan ve diğer metinler için: <a asp-controller="ContentTexts" asp-action="Index" asp-route-group="home">Sayfa İçerikleri → Ana Sayfa</a></div>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-brand btn-lg"><i class="fa-solid fa-floppy-disk me-1"></i>Ayarları Kaydet</button>
</form>
