@model IReadOnlyList<LegacyRedirectAdminItem>
@{
    ViewData["Title"] = "Yönlendirmeler";
}
<div class="admin-card">
    <div class="admin-card-header">
        <span class="text-muted small">Eski sitenin adresleri yeni sayfalara kalıcı (301) olarak yönlenir; Google sıralaması böylece korunur.</span>
        <a asp-action="Create" class="btn btn-brand"><i class="fa-solid fa-plus me-1"></i>Yeni Yönlendirme</a>
    </div>
    <div class="table-responsive">
        <table class="table admin-table">
            <thead><tr><th>Eski adres</th><th>Yeni adres (TR)</th><th>Yeni adres (EN)</th><th>Kullanım</th><th></th></tr></thead>
            <tbody>
                @foreach (var redirect in Model)
                {
                    <tr>
                        <td><a asp-action="Edit" asp-route-id="@redirect.Id" class="fw-semibold">@redirect.FromPath</a></td>
                        <td class="small"><a href="@redirect.ToPath" target="_blank" rel="noopener">@redirect.ToPath</a></td>
                        <td class="small">@if (redirect.ToPathEn is not null) { <a href="@redirect.ToPathEn" target="_blank" rel="noopener">@redirect.ToPathEn</a> } else { <span class="text-muted">-</span> }</td>
                        <td>@redirect.HitCount</td>
                        <td>
                            <div class="actions">
                                <a asp-action="Edit" asp-route-id="@redirect.Id" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-pen"></i></a>
                                <form method="post" asp-action="Delete" asp-route-id="@redirect.Id" data-confirm="Bu yönlendirmeyi silmek istediğinize emin misiniz?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">Henüz yönlendirme yok.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
