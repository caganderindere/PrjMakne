@model JobApplicationDto
@{
    ViewData["Title"] = "Başvuru Detayı";
}
<div class="row g-4">
    <div class="col-lg-8">
        <div class="admin-card">
            <h2 class="admin-card-title mb-3">@Model.FullName — @CareerAreas.Name(Model.Position)</h2>
            <div class="message-body">@(Model.Message ?? "Ön yazı eklenmemiş.")</div>
            <div class="mt-4 d-flex flex-wrap gap-2">
                <a asp-action="Resume" asp-route-id="@Model.Id" class="btn btn-brand"><i class="fa-solid fa-file-arrow-down me-1"></i>CV'yi İndir</a>
                <a href="mailto:@Model.Email?subject=@Uri.EscapeDataString("İş başvurunuz hakkında")" class="btn btn-outline-dark"><i class="fa-solid fa-reply me-1"></i>E-posta ile Yanıtla</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="admin-card">
            <dl class="detail-list mb-0">
                <dt>Ad Soyad</dt><dd>@Model.FullName</dd>
                <dt>Alan</dt><dd>@CareerAreas.Name(Model.Position)</dd>
                <dt>E-posta</dt><dd><a href="mailto:@Model.Email">@Model.Email</a></dd>
                <dt>Telefon</dt><dd><a href="tel:@Model.Phone.Replace(" ", "")">@Model.Phone</a></dd>
                <dt>Şehir</dt><dd>@(Model.City ?? "-")</dd>
                <dt>CV</dt><dd>@Model.ResumeOriginalName <span class="text-muted small">(@(Model.ResumeSize / 1024) KB)</span></dd>
                <dt>Dil</dt><dd>@Languages.DisplayName(Model.LanguageCode)</dd>
                <dt>Tarih</dt><dd>@Model.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
                <dt>IP Adresi</dt><dd>@(Model.IpAddress ?? "-")</dd>
            </dl>
            <form method="post" asp-action="Delete" asp-route-id="@Model.Id" data-confirm="Bu başvuruyu ve CV'yi silmek istediğinize emin misiniz?" class="mt-2">
                <button type="submit" class="btn btn-outline-danger w-100"><i class="fa-solid fa-trash me-1"></i>Başvuruyu ve CV'yi Sil</button>
            </form>
        </div>
    </div>
</div>
