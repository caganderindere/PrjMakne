@model PagedResult<JobApplicationDto>
@{
    ViewData["Title"] = "İnsan Kaynakları — Başvurular";
    bool? unread = ViewBag.Unread;
    var pager = (Model.Page, Model.TotalPages, (Func<int, string>)(p => Url.Action("Index", new { unread, page = p })!));
}
<div class="admin-card">
    <div class="admin-card-header">
        <div class="btn-group">
            <a asp-action="Index" class="btn btn-sm @(unread == true ? "btn-outline-dark" : "btn-dark")">Tümü</a>
            <a asp-action="Index" asp-route-unread="true" class="btn btn-sm @(unread == true ? "btn-dark" : "btn-outline-dark")">Okunmamış</a>
        </div>
        <span class="text-muted small">@Model.TotalCount başvuru</span>
    </div>
    <div class="table-responsive">
        <table class="table admin-table">
            <thead><tr><th>Aday</th><th>Alan</th><th>Şehir</th><th>CV</th><th>Tarih</th><th></th></tr></thead>
            <tbody>
                @foreach (var application in Model.Items)
                {
                    <tr class="@(application.IsRead ? null : "unread")">
                        <td><a asp-action="Detail" asp-route-id="@application.Id">@application.FullName</a><div class="small text-muted">@application.Email · @application.Phone</div></td>
                        <td>@CareerAreas.Name(application.Position)</td>
                        <td>@(application.City ?? "-")</td>
                        <td><a asp-action="Resume" asp-route-id="@application.Id" title="@application.ResumeOriginalName"><i class="fa-solid fa-file-arrow-down"></i></a></td>
                        <td class="small text-nowrap">@application.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <div class="actions">
                                <a asp-action="Detail" asp-route-id="@application.Id" class="btn btn-sm btn-outline-dark"><i class="fa-solid fa-eye"></i></a>
                                <form method="post" asp-action="Delete" asp-route-id="@application.Id" data-confirm="Bu başvuruyu ve CV'yi silmek istediğinize emin misiniz?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">Başvuru bulunamadı.</td></tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_AdminPager" model="pager" />
</div>
