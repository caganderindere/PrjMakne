<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PrjProje</AssemblyName>
    <RootNamespace>PrjProje</RootNamespace>
    <UserSecretsId>prj-web-4b9e2a71-6c3d-4f0e-9a52-1d7c8e3b5f20</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\uploads\" />
  </ItemGroup>

  <!-- Server-only settings: never copied into the publish folder, so a copy-paste deploy
       cannot overwrite the production connection string kept on the server. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json;appsettings.Production.json;appsettings.Production.example.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Files uploaded on a development machine never ship; the server keeps its own uploads folder. -->
  <ItemGroup>
    <Content Update="wwwroot/uploads/**" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <!-- Catalogue exported from the old site; loaded into an empty database on first start. -->
  <ItemGroup>
    <None Include="../content/seed/*.json" Exclude="../content/seed/pages.json" LinkBase="SeedContent/seed"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../content/images/gallery/**/*" LinkBase="SeedContent/images/gallery"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../content/images/products/**/*" LinkBase="SeedContent/images/products"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
