@model FairLeadFormModel
@{
    Layout = "_FairLayout";
    var fair = (FairDto)ViewBag.Fair;
    ViewData["FairPage"] = fair;
    ViewData["FairRoute"] = SiteRoutes.Fair;
}
<form method="post" action="@Url.Localized(SiteRoutes.Fair, fair.Slug)" asp-antiforgery="true" class="fair-form">
    <partial name="_SpamProtection" />
    <p class="fair-lead">@(fair.EmailRequired ? L["Fair.Lead"] : L["Fair.LeadOptional"])</p>
    <label asp-for="Email" class="fair-label">@L["Fair.Email"]</label>
    <input asp-for="Email" type="email" class="fair-input" autocomplete="email" inputmode="email" required="@fair.EmailRequired" />
    <span asp-validation-for="Email" class="fair-error"></span>
    @if (fair.ShowMarketingConsent)
    {
        <label class="fair-check">
            <input asp-for="MarketingConsent" />
            <span>@L["Fair.Marketing"]</span>
        </label>
    }
    <p class="fair-notice">@L["Fair.Notice"] <a href="@Url.Localized(SiteRoutes.Privacy)" target="_blank" rel="noopener">@L["Legal.PrivacyTitle"]</a></p>
    <partial name="_Turnstile" model="PrjProje.Application.Interfaces.TurnstileForm.Fair" />
    <div asp-validation-summary="ModelOnly" class="fair-error"></div>
    <button type="submit" class="card-save fair-submit"><i class="fa-solid fa-book-open" aria-hidden="true"></i>@L["Fair.Submit"]</button>
    @if (!fair.EmailRequired)
    {
        <a href="@Url.Localized(SiteRoutes.FairBrochure, fair.Slug)" class="fair-skip">@L["Fair.Skip"]</a>
    }
</form>
