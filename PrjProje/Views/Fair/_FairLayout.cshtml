@{
    Layout = null;
    var site = (SiteSettingsDto)ViewBag.Settings;
    var fair = (FairDto)ViewData["FairPage"]!;
    var routeKey = (string)ViewData["FairRoute"]!;
}
<!DOCTYPE html>
<html lang="@Languages.Current">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@fair.Title | @site.CompanyName</title>
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#17191e" />
    <link rel="icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="~/images/favicon-96.png" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700&display=swap" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/card.css" asp-append-version="true" />
</head>
<body>
    <main class="card">
        <header class="card-top fair-top">
            <span class="card-stripes" aria-hidden="true"></span>
            <a href="@Url.Localized(SiteRoutes.Home)" class="card-logo"><img src="~/images/logo-light.png" alt="@site.CompanyName" width="140" height="30" /></a>
            <nav class="card-lang" aria-label="Language">
                @foreach (var language in Languages.All)
                {
                    <a href="@Url.Localized(routeKey, language, fair.Slug)" lang="@language" aria-current="@(language == Languages.Current ? "true" : null)">@language.ToUpperInvariant()</a>
                }
            </nav>
        </header>

        <section class="fair-intro">
            <h1 class="card-name">@fair.Title</h1>
            @if (!string.IsNullOrWhiteSpace(fair.Intro))
            {
                <p class="card-note">@fair.Intro</p>
            }
        </section>

        @RenderBody()

        <footer class="card-foot">
            <span class="card-foot-mark">@site.CompanyName</span>
            <span>@L["Card.Tagline"]</span>
        </footer>
    </main>
</body>
</html>
