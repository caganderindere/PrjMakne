@model FairDto
@{
    Layout = "_FairLayout";
    var site = (SiteSettingsDto)ViewBag.Settings;
    ViewData["FairPage"] = Model;
    ViewData["FairRoute"] = SiteRoutes.FairBrochure;
    var website = Url.Absolute(Url.Localized(SiteRoutes.Home));
}
<div class="fair-brochure">
    <a href="@Model.BrochurePdf" target="_blank" rel="noopener" class="card-save"><i class="fa-solid fa-file-pdf" aria-hidden="true"></i>@L["Fair.OpenBrochure"]</a>
</div>
<ul class="card-links">
    <li>
        <a href="@website" target="_blank" rel="noopener">
            <span class="card-ico"><i class="fa-solid fa-globe" aria-hidden="true"></i></span>
            <span class="card-link-text"><span class="card-link-value">@L["Card.Website"]</span></span>
            <i class="fa-solid fa-arrow-right card-arrow" aria-hidden="true"></i>
        </a>
    </li>
    @foreach (var (icon, url, label) in site.GetSocialLinks())
    {
        <li>
            <a href="@url" target="_blank" rel="noopener">
                <span class="card-ico"><i class="@icon" aria-hidden="true"></i></span>
                <span class="card-link-text"><span class="card-link-value">@label</span></span>
                <i class="fa-solid fa-arrow-right card-arrow" aria-hidden="true"></i>
            </a>
        </li>
    }
    @foreach (var (label, url) in CardLinks.ExtraLinks(Model.ExtraLinks))
    {
        <li>
            <a href="@url" target="_blank" rel="noopener">
                <span class="card-ico"><i class="fa-solid fa-link" aria-hidden="true"></i></span>
                <span class="card-link-text"><span class="card-link-value">@label</span></span>
                <i class="fa-solid fa-arrow-right card-arrow" aria-hidden="true"></i>
            </a>
        </li>
    }
</ul>
<div class="fair-spacer"></div>
