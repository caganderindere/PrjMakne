@{
    var header = new PageHeaderModel(L["Legal.PrivacyTitle"], L["Legal.PrivacyLead"]);
    var sections = Enumerable.Range(1, 6);
}
<partial name="_PageHeader" model="header" />

<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 rich-content legal-content">
                <p>@L["Legal.PrivacyIntro"]</p>
                @foreach (var index in sections)
                {
                    <h2>@L[$"Legal.Privacy{index}Title"]</h2>
                    <p>@L[$"Legal.Privacy{index}Text"]</p>
                }
            </div>
        </div>
    </div>
</section>
