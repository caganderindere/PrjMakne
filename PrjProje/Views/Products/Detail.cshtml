@model ProductDetailDto
@{
    // The main image comes first; gallery photos carry their own descriptions.
    var images = new List<ProductImageDto>();
    if (Model.Image is not null) { images.Add(new ProductImageDto(Model.Image, Model.Name)); }
    images.AddRange(Model.Images.Where(i => i.Path != Model.Image));
    var quoteUrl = $"{Url.Localized(SiteRoutes.Quote)}?product={Model.Id}";
    ViewData["QuoteHref"] = quoteUrl;
    // Picked up by the layout: product-specific WhatsApp message.
    ViewData["WhatsAppText"] = L["Products.WhatsAppTemplate", Model.Name, $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}"].Value;
    var crumbs = (ViewData[PageSeo.ViewDataKey] as PageSeo)?.Breadcrumbs ?? new List<BreadcrumbItem>();
}

<section class="section product-hero">
    <div class="container">
        @if (crumbs.Count > 1)
        {
            <nav aria-label="Breadcrumb">
                <ol class="breadcrumb">
                    @foreach (var crumb in crumbs)
                    {
                        <li>@if (crumb.Url is not null) { <a href="@crumb.Url">@crumb.Title</a> } else { <span aria-current="page">@crumb.Title</span> }</li>
                    }
                </ol>
            </nav>
        }
        <div class="product-layout">
            <div data-gallery>
                @if (images.Count > 0)
                {
                    <a href="@images[0].Path" class="gallery-main" data-gallery-main data-lightbox="product" data-alt="@images[0].Alt">
                        <img src="@images[0].Path" srcset="@ViewHelpers.SrcSet(images[0].Path)" sizes="(max-width: 960px) 100vw, 58vw" alt="@images[0].Alt" width="1600" height="1200" fetchpriority="high" />
                        <span class="zoom-hint">@ViewHelpers.Icon("search") @L["Common.Zoom"]</span>
                    </a>
                    @if (images.Count > 1)
                    {
                        <div class="gallery-thumbs">
                            @for (var i = 0; i < images.Count; i++)
                            {
                                <button type="button" data-gallery-thumb data-index="@i" data-src="@images[i].Path" data-srcset="@ViewHelpers.SrcSet(images[i].Path)" data-alt="@images[i].Alt"
                                        aria-current="@(i == 0 ? "true" : "false")" aria-label="@L["Products.ShowImage", i + 1]">
                                    <img src="@ViewHelpers.SmallImage(images[i].Path)" alt="" loading="lazy" decoding="async" width="120" height="120" />
                                </button>
                            }
                        </div>
                        @foreach (var image in images.Skip(1))
                        {
                            <a href="@image.Path" data-lightbox="product" data-alt="@image.Alt" hidden tabindex="-1" aria-hidden="true"></a>
                        }
                    }
                }
                else
                {
                    <div class="gallery-main">@ViewHelpers.Icon("package")</div>
                }
            </div>

            <div class="product-summary">
                <div class="sticky-quote">
                    <a href="@Url.Localized(SiteRoutes.ProductCategory, Model.CategorySlug)" class="category-link">@ViewHelpers.Icon("layers") @Model.CategoryName</a>
                    <h1>@Model.Name</h1>
                    @if (!string.IsNullOrEmpty(Model.ShortDescription))
                    {
                        <p class="lead">@Model.ShortDescription</p>
                    }
                    @if (Model.Variants.Count > 0)
                    {
                        <div class="variants">
                            <h2>@L["Products.Variants"]</h2>
                            <ul class="chips chips-strong">
                                @foreach (var code in Model.Variants)
                                {
                                    <li>@code</li>
                                }
                            </ul>
                        </div>
                    }
                    @if (Model.IsRestricted)
                    {
                        <p class="notice">@ViewHelpers.Icon("info") <span>@L["Products.ConfidentialityNotice"]</span></p>
                    }
                    <div class="button-row">
                        <a href="@quoteUrl" class="btn btn-primary btn-lg">@L["Products.RequestQuoteForProduct"]</a>
                        <a href="@Url.Localized(SiteRoutes.Contact)" class="btn btn-outline btn-lg">@L["Nav.Contact"]</a>
                    </div>
                    <ul class="check-list" style="margin-top: var(--space-6)">
                        <li>@ViewHelpers.Icon("check") @L["Products.PointCustom"]</li>
                        <li>@ViewHelpers.Icon("check") @L["Products.PointInstall"]</li>
                        <li>@ViewHelpers.Icon("check") @L["Products.PointSpares"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container split split-wide">
        <div>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <h2>@L["Products.Description"]</h2>
                <div class="prose">@Html.Raw(Model.Description)</div>
            }
            @if (Model.Specifications.Count > 0)
            {
                <h2>@L["Products.Specifications"]</h2>
                <div class="table-scroll">
                    <table class="spec-table">
                        <tbody>
                            @foreach (var spec in Model.Specifications)
                            {
                                <tr><th scope="row">@spec.Name</th><td>@spec.Value</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (Model.ApplicationAreas.Count > 0)
            {
                <h2>@L["Products.ApplicationAreas"]</h2>
                <ul class="chips">
                    @foreach (var area in Model.ApplicationAreas)
                    {
                        <li>@area</li>
                    }
                </ul>
            }
        </div>
        <aside class="stack">
            <div class="side-card side-card-dark">
                <h2>@L["Products.QuoteBoxTitle"]</h2>
                <p>@L["Products.QuoteBoxText"]</p>
                <a href="@quoteUrl" class="btn btn-primary btn-block">@L["Common.RequestQuote"]</a>
            </div>
            <div class="side-card">
                <h2>@L["Nav.Manuals"]</h2>
                <p>@L["Products.ManualsText"]</p>
                <a href="@Url.Localized(SiteRoutes.Manuals)" class="link-arrow">@L["Products.ManualsLink"] @ViewHelpers.Icon("arrow-right")</a>
            </div>
        </aside>
    </div>
</section>

@if (Model.RelatedProducts.Count > 0)
{
    <section class="section">
        <div class="container">
            <div class="section-head">
                <div><h2>@L["Products.Related"]</h2></div>
                <a href="@Url.Localized(SiteRoutes.ProductCategory, Model.CategorySlug)" class="link-arrow">@Model.CategoryName @ViewHelpers.Icon("arrow-right")</a>
            </div>
            <div class="grid grid-4">
                @foreach (var product in Model.RelatedProducts)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </div>
    </section>
}
