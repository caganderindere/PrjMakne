@model ProductDetailDto
@{
    var images = new List<string>();
    if (Model.Image is not null) images.Add(Model.Image);
    images.AddRange(Model.Images.Where(i => i != Model.Image));
    var quoteUrl = $"{Url.Localized(SiteRoutes.Quote)}?product={Model.Id}";
    // Picked up by the layout: product-specific WhatsApp message plus the "ask marketing" bubble.
    ViewData["WhatsAppText"] = L["Products.WhatsAppTemplate", Model.Name, $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}"].Value;
}

<section class="section pt-5">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6">
                <div class="product-gallery" data-product-gallery>
                    <div class="product-gallery-main">
                        @if (images.Count > 0)
                        {
                            <a href="@images[0]" data-lightbox="product" data-gallery-main>
                                <img src="@images[0]" srcset="@ViewHelpers.SrcSet(images[0])" sizes="(max-width: 992px) 100vw, 50vw" alt="@Model.Name" width="960" height="720" fetchpriority="high" />
                            </a>
                        }
                        else
                        {
                            <span class="media-placeholder media-placeholder-lg"><i class="@Model.CategoryIcon" aria-hidden="true"></i></span>
                        }
                    </div>
                    @if (images.Count > 1)
                    {
                        <div class="product-gallery-thumbs">
                            @for (var i = 0; i < images.Count; i++)
                            {
                                <button type="button" class="@(i == 0 ? "active" : null)" data-gallery-thumb="@images[i]" aria-label="@L["Products.ShowImage", i + 1]">
                                    <img src="@ViewHelpers.SmallImage(images[i])" alt="" loading="lazy" decoding="async" width="120" height="90" />
                                </button>
                            }
                        </div>
                        @foreach (var image in images.Skip(1))
                        {
                            <a href="@image" data-lightbox="product" class="d-none" aria-hidden="true" tabindex="-1"></a>
                        }
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <a href="@Url.Localized(SiteRoutes.ProductCategory, Model.CategorySlug)" class="product-category-tag"><i class="@Model.CategoryIcon me-2" aria-hidden="true"></i>@Model.CategoryName</a>
                <h1 class="product-title">@Model.Name</h1>
                @if (Model.Variants.Count > 0)
                {
                    <div class="product-variants">
                        <span class="product-variants-label">@L["Products.Variants"]</span>
                        <ul class="product-variant-list">
                            @foreach (var code in Model.Variants)
                            {
                                <li>@code</li>
                            }
                        </ul>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.ShortDescription))
                {
                    <p class="lead-text">@Model.ShortDescription</p>
                }
                <dl class="product-facts">
                    <div><dt>@L["Products.Origin"]</dt><dd>@L["Products.OriginValue"]</dd></div>
                </dl>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a href="@quoteUrl" class="btn btn-brand btn-lg"><i class="fa-solid fa-file-signature me-2" aria-hidden="true"></i>@L["Products.RequestQuoteForProduct"]</a>
                    <a href="@Url.Localized(SiteRoutes.Contact)" class="btn btn-outline-dark btn-lg">@L["Nav.Contact"]</a>
                </div>
                @if (Model.IsRestricted)
                {
                    <div class="notice notice-dark mt-4">
                        <i class="fa-solid fa-user-lock" aria-hidden="true"></i>
                        <span>@L["Products.ConfidentialityNotice"]</span>
                    </div>
                }
            </div>
        </div>

        <div class="row g-5 mt-2">
            <div class="col-lg-8">
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="content-block">
                        <h2 class="content-title">@L["Products.Description"]</h2>
                        <div class="rich-content">@Html.Raw(Model.Description)</div>
                    </div>
                }
                @if (Model.Specifications.Count > 0)
                {
                    <div class="content-block">
                        <h2 class="content-title">@L["Products.Specifications"]</h2>
                        <div class="table-responsive">
                            <table class="table spec-table">
                                <tbody>
                                    @foreach (var spec in Model.Specifications)
                                    {
                                        <tr><th scope="row">@spec.Name</th><td>@spec.Value</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
            <div class="col-lg-4">
                @if (Model.ApplicationAreas.Count > 0)
                {
                    <div class="side-card">
                        <h2 class="side-card-title">@L["Products.ApplicationAreas"]</h2>
                        <ul class="check-list mb-0">
                            @foreach (var area in Model.ApplicationAreas)
                            {
                                <li>@area</li>
                            }
                        </ul>
                    </div>
                }
                <div class="side-card side-card-dark">
                    <h2 class="side-card-title">@L["Products.QuoteBoxTitle"]</h2>
                    <p>@L["Products.QuoteBoxText"]</p>
                    <a href="@quoteUrl" class="btn btn-brand w-100">@L["Common.RequestQuote"]</a>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.RelatedProducts.Count > 0)
{
    <section class="section section-light">
        <div class="container">
            <div class="section-heading">
                <h2 class="section-title">@L["Products.Related"]</h2>
            </div>
            <div class="row g-4">
                @foreach (var product in Model.RelatedProducts)
                {
                    <div class="col-sm-6 col-lg-3">
                        <partial name="_ProductCard" model="product" />
                    </div>
                }
            </div>
        </div>
    </section>
}
