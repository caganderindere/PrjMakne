@model ProductListViewModel
@{
    var category = Model.CurrentCategory;
    var basePath = category is null ? Url.Localized(SiteRoutes.Products) : Url.Localized(SiteRoutes.ProductCategory, category.Slug);
    var pagination = new PaginationModel(Model.Products.Page, Model.Products.TotalPages, basePath,
        new Dictionary<string, string?> { ["q"] = Model.Search });
    var header = new PageHeaderModel(category?.Name ?? L["Products.Title"], category is null ? L["Products.Lead"].Value : null, Image: category?.Image);
}
<partial name="_PageHeader" model="header" />

<section class="section">
    <div class="container split split-aside">
        <aside class="filter-nav" aria-label="@L["Products.Categories"]">
            <partial name="_ProductSearchForm" model='new ProductSearchFormModel(basePath, "productSearch", Model.Search, category?.Slug)' />
            <h2>@L["Products.Categories"]</h2>
            <ul class="filter-list">
                <li>
                    <a href="@Url.Localized(SiteRoutes.Products)" aria-current="@(category is null ? "page" : null)">
                        <span>@L["Products.AllProducts"]</span><span class="count">@Model.Categories.Sum(c => c.ProductCount)</span>
                    </a>
                </li>
                @foreach (var item in Model.Categories)
                {
                    <li>
                        <a href="@Url.Localized(SiteRoutes.ProductCategory, item.Slug)" aria-current="@(category?.Id == item.Id ? "page" : null)">
                            <span>@item.Name</span><span class="count">@item.ProductCount</span>
                        </a>
                    </li>
                }
                <li><a href="@Url.Localized(SiteRoutes.Manuals)"><span>@L["Nav.Manuals"]</span></a></li>
            </ul>
        </aside>

        <div>
            @if (category?.Description is not null)
            {
                <div class="prose">@Html.Raw(category.Description)</div>
            }
            <p class="result-line">
                <span>@L["Products.ResultCount", Model.Products.TotalCount]</span>
                @if (Model.Search is not null)
                {
                    <span>“@Model.Search”</span>
                    <a href="@basePath">@L["Common.ClearFilter"]</a>
                }
            </p>
            @if (category?.IsRestricted == true)
            {
                <p class="notice">@ViewHelpers.Icon("info") <span>@L["Products.ConfidentialityNotice"]</span></p>
            }
            @if (Model.Products.Items.Count == 0)
            {
                <div class="empty-state">
                    @ViewHelpers.Icon("package")
                    <h2>@L["Products.EmptyTitle"]</h2>
                    <p>@L["Products.EmptyText"]</p>
                    <a href="@Url.Localized(SiteRoutes.Quote)" class="btn btn-primary">@L["Common.RequestQuote"]</a>
                </div>
            }
            else
            {
                <div class="grid grid-3">
                    @foreach (var product in Model.Products.Items)
                    {
                        <partial name="_ProductCard" model="product" />
                    }
                </div>
                <partial name="_Pagination" model="pagination" />
            }
        </div>
    </div>
</section>

<partial name="_CtaSection" />

@section Scripts {
    <script src="~/js/products-search.js" asp-append-version="true" defer></script>
}
