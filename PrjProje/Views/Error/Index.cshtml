@model ErrorViewModel
<section class="error-page">
    <div class="container">
        <span class="error-code" aria-hidden="true">@Model.StatusCode</span>
        <h1>@(Model.StatusCode == 404 ? L["Error.NotFoundTitle"] : L["Error.GenericTitle"])</h1>
        <p class="lead">@(Model.StatusCode == 404 ? L["Error.NotFoundText"] : L["Error.GenericText"])</p>
        <div class="button-row">
            <a href="@Url.Localized(SiteRoutes.Home)" class="btn btn-primary btn-lg">@L["Error.BackHome"]</a>
            <a href="@Url.Localized(SiteRoutes.Products)" class="btn btn-outline btn-lg">@L["Nav.Products"]</a>
        </div>
    </div>
</section>
