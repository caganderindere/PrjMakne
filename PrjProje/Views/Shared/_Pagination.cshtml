@model PaginationModel
@if (Model.TotalPages > 1)
{
    string PageUrl(int page)
    {
        var query = new Dictionary<string, string?>(Model.Query) { ["page"] = page > 1 ? page.ToString() : null };
        var parts = query.Where(q => !string.IsNullOrEmpty(q.Value)).Select(q => $"{q.Key}={Uri.EscapeDataString(q.Value!)}");
        var queryString = string.Join("&", parts);
        return queryString.Length == 0 ? Model.BasePath : $"{Model.BasePath}?{queryString}";
    }

    <nav aria-label="@L["Common.Pagination"]">
        <ul class="pagination">
            <li><a class="@(Model.Page <= 1 ? "is-disabled" : null)" href="@PageUrl(Model.Page - 1)" rel="prev">@L["Common.Previous"]</a></li>
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                if (i == 1 || i == Model.TotalPages || Math.Abs(i - Model.Page) <= 2)
                {
                    <li><a href="@PageUrl(i)" aria-current="@(i == Model.Page ? "page" : null)">@i</a></li>
                }
                else if (Math.Abs(i - Model.Page) == 3)
                {
                    <li><span>…</span></li>
                }
            }
            <li><a class="@(Model.Page >= Model.TotalPages ? "is-disabled" : null)" href="@PageUrl(Model.Page + 1)" rel="next">@L["Common.Next"]</a></li>
        </ul>
    </nav>
}
