@model ProductListItemDto
@{
    var url = Url.Localized(SiteRoutes.ProductDetail, Model.Slug);
    var quoteUrl = $"{Url.Localized(SiteRoutes.Quote)}?product={Model.Id}";
}
<article class="card product-card">
    <div class="card-media">
        <span class="card-tag">@Model.CategoryName</span>
        @if (Model.Image is not null)
        {
            <img src="@ViewHelpers.SmallImage(Model.Image)" srcset="@ViewHelpers.SrcSet(Model.Image)" sizes="(max-width: 640px) 100vw, (max-width: 960px) 50vw, 33vw"
                 alt="@Model.Name" loading="lazy" decoding="async" width="640" height="480" />
        }
        else
        {
            @ViewHelpers.Icon("package")
        }
    </div>
    <div class="card-body">
        <h3 class="card-title"><a href="@url">@Model.Name</a></h3>
        @if (!string.IsNullOrEmpty(Model.ShortDescription))
        {
            <p class="card-text">@ViewHelpers.Truncate(Model.ShortDescription, 140)</p>
        }
        <div class="card-meta">
            <a href="@url" class="link-arrow">@L["Common.ViewDetails"] @ViewHelpers.Icon("arrow-right")</a>
            <a href="@quoteUrl" class="quote-link" aria-label="@L["Common.RequestQuote"]: @Model.Name">@ViewHelpers.Icon("send")</a>
        </div>
    </div>
</article>
