<section class="cta-band">
    <div class="container cta-inner">
        <div>
            <p class="eyebrow">@L["Cta.Eyebrow"]</p>
            <h2>@L["Cta.Title"]</h2>
            <p>@L["Cta.Text"]</p>
        </div>
        <div class="cta-actions">
            <a href="@Url.Localized(SiteRoutes.Quote)" class="btn btn-primary btn-lg">@L["Common.RequestQuote"]</a>
            <a href="@Url.Localized(SiteRoutes.Contact)" class="btn btn-ghost-light btn-lg">@L["Nav.Contact"]</a>
        </div>
    </div>
</section>
