@inject PrjProje.Application.Interfaces.ISiteSettingsService SettingsService
@inject PrjProje.Application.Interfaces.IProductService ProductService
@inject PrjProje.Application.Interfaces.IServicePageService ServicePageService
@inject PrjProje.Application.Interfaces.IBlogService BlogService
@inject PrjProje.Application.Interfaces.IDocumentService DocumentService
@inject PrjProje.Application.Interfaces.IGalleryService GalleryService
@inject PrjProje.Application.Interfaces.ISiteContentService SiteContentService
@using PrjProje.Domain.Enums
@{
    var lang = Languages.Current;
    var seo = ViewData[PageSeo.ViewDataKey] as PageSeo ?? new PageSeo { Title = L["Home.MetaTitle"], CanonicalPath = Context.Request.Path };
    var settings = await SettingsService.GetAsync();
    var categories = await ProductService.GetCategoriesAsync(lang);
    var documents = await DocumentService.GetPublicDocumentsAsync(lang);

    // Sections without content stay out of the menu (an empty blog, no manuals uploaded yet, ...).
    var hasServices = (await ServicePageService.GetServicesAsync(lang)).Count > 0;
    var hasBlog = (await BlogService.GetLatestAsync(lang, 1)).Count > 0;
    var hasVideos = (await GalleryService.GetGalleryAsync(lang)).Items.Count > 0;
    var hasManuals = documents.Any(d => d.DocumentType == DocumentType.Catalog);
    var hasCertificates = documents.Any(d => d.DocumentType != DocumentType.Catalog);

    var announcements = await SiteContentService.GetCurrentAnnouncementsAsync(lang);
    var bar = announcements.FirstOrDefault(a => a.DisplayType == AnnouncementDisplay.Bar);
    var popup = announcements.FirstOrDefault(a => a.DisplayType == AnnouncementDisplay.Popup);
    static bool IsExternal(string url) => !url.StartsWith('/');

    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string? Current(params string[] names) => names.Contains(controller) ? "page" : null;
    var phoneHref = "tel:" + new string(settings.Phone.Where(c => char.IsDigit(c) || c == '+').ToArray());
    var whatsAppHref = WhatsAppLink.Build(settings.WhatsApp, ViewData["WhatsAppText"] as string ?? settings.GetWhatsAppMessage(lang));
    var quoteHref = ViewData["QuoteHref"] as string ?? Url.Localized(SiteRoutes.Quote);
    ViewData["Settings"] = settings;
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1C2127" />
    <partial name="_SeoHead" model="seo" />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-condensed-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" sizes="48x48" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="~/images/apple-touch-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">@L["Common.SkipToContent"]</a>

    @if (bar is not null)
    {
        <div class="announcement-bar" role="region" aria-label="@L["Announcement.Label"]" data-announcement="@($"{bar.Id}-{bar.Version}")">
            <div class="container announcement-inner">
                <p class="announcement-text">@bar.Message</p>
                @if (bar.LinkUrl is not null)
                {
                    <a href="@bar.LinkUrl" class="announcement-link" target="@(IsExternal(bar.LinkUrl) ? "_blank" : null)" rel="@(IsExternal(bar.LinkUrl) ? "noopener" : null)">@(bar.LinkText ?? L["Announcement.More"].Value)@ViewHelpers.Icon("arrow-right")</a>
                }
                <button type="button" class="icon-button announcement-close" data-announcement-close aria-label="@L["Announcement.Close"]">@ViewHelpers.Icon("x")</button>
            </div>
        </div>
    }

    <header class="site-header" data-header>
        <div class="container header-inner">
            <a class="brand" href="@Url.Localized(SiteRoutes.Home)">
                <img src="~/images/brand/prj-logo-horizontal.svg" alt="@settings.CompanyName" width="200" height="37" />
            </a>

            <nav class="main-nav" id="mainNav" aria-label="@L["Common.MainNavigation"]" data-nav>
                <div class="nav-panel-head">
                    <span class="nav-panel-title">@L["Nav.Menu"]</span>
                    <button type="button" class="icon-button" data-nav-close aria-label="@L["Nav.CloseMenu"]">@ViewHelpers.Icon("x")</button>
                </div>
                <ul class="nav-list">
                    <li class="nav-item has-sub has-mega">
                        <a class="nav-link" href="@Url.Localized(SiteRoutes.Products)" aria-current="@Current("Products")">@L["Nav.Products"]</a>
                        <button type="button" class="sub-toggle" aria-expanded="false" aria-controls="sub-products" aria-label="@L["Nav.Products"]">@ViewHelpers.Icon("chevron-down")</button>
                        <div class="sub mega" id="sub-products">
                            <div class="container mega-inner">
                                <div>
                                    <p class="mega-title">@L["Nav.ProductCategories"]</p>
                                    <ul class="mega-grid">
                                        @foreach (var category in categories)
                                        {
                                            <li>
                                                <a class="mega-card" href="@Url.Localized(SiteRoutes.ProductCategory, category.Slug)">
                                                    <span class="mega-thumb">
                                                        @if (category.Image is not null)
                                                        {
                                                            <img src="@ViewHelpers.SmallImage(category.Image)" alt="" loading="lazy" width="96" height="72" />
                                                        }
                                                    </span>
                                                    <span class="mega-name">@category.Name</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                                <aside class="mega-aside">
                                    <p class="mega-aside-title">@L["Nav.TurnkeyTitle"]</p>
                                    <p>@L["Nav.TurnkeyText"]</p>
                                    @if (hasServices)
                                    {
                                        <a class="link-arrow" href="@Url.Localized(SiteRoutes.Services)">@L["Nav.Services"]@ViewHelpers.Icon("arrow-right")</a>
                                    }
                                    <a class="btn btn-primary" href="@Url.Localized(SiteRoutes.Products)">@L["Nav.AllProducts"]</a>
                                </aside>
                            </div>
                        </div>
                    </li>
                    @if (hasServices)
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Localized(SiteRoutes.Services)" aria-current="@Current("Services")">@L["Nav.Services"]</a></li>
                    }
                    <li class="nav-item has-sub">
                        <a class="nav-link" href="@Url.Localized(SiteRoutes.About)" aria-current="@Current("About", "Certificates")">@L["Nav.About"]</a>
                        @if (hasCertificates)
                        {
                            <button type="button" class="sub-toggle" aria-expanded="false" aria-controls="sub-about" aria-label="@L["Nav.About"]">@ViewHelpers.Icon("chevron-down")</button>
                            <ul class="sub dropdown" id="sub-about">
                                <li><a href="@Url.Localized(SiteRoutes.About)">@L["Nav.AboutUs"]</a></li>
                                <li><a href="@Url.Localized(SiteRoutes.Certificates)">@L["Nav.Certificates"]</a></li>
                            </ul>
                        }
                    </li>
                    @if (hasVideos)
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Localized(SiteRoutes.Videos)" aria-current="@Current("Videos")">@L["Nav.Videos"]</a></li>
                    }
                    @if (hasManuals)
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Localized(SiteRoutes.Manuals)" aria-current="@Current("Manuals")">@L["Nav.Manuals"]</a></li>
                    }
                    @if (hasBlog)
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Localized(SiteRoutes.Blog)" aria-current="@Current("Blog")">@L["Nav.Blog"]</a></li>
                    }
                    <li class="nav-item"><a class="nav-link" href="@Url.Localized(SiteRoutes.Contact)" aria-current="@Current("Contact")">@L["Nav.Contact"]</a></li>
                </ul>
                <div class="nav-panel-foot">
                    <a class="btn btn-primary btn-block" href="@quoteHref">@L["Common.RequestQuote"]</a>
                    <a class="nav-panel-phone" href="@phoneHref">@ViewHelpers.Icon("phone")@settings.Phone</a>
                </div>
            </nav>

            <div class="header-actions">
                <a class="header-phone" href="@phoneHref">@ViewHelpers.Icon("phone")<span>@settings.Phone</span></a>
                <partial name="_LanguageMenu" model="seo" />
                <a class="btn btn-primary header-quote" href="@quoteHref">@L["Common.RequestQuote"]</a>
                <button type="button" class="icon-button nav-toggle" aria-controls="mainNav" aria-expanded="false" data-nav-open aria-label="@L["Nav.Menu"]">@ViewHelpers.Icon("menu")</button>
            </div>
        </div>
    </header>
    <div class="nav-backdrop" data-nav-close hidden></div>

    <main id="main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <div class="footer-brand">
                <img src="~/images/brand/prj-logo-negative.svg" alt="@settings.CompanyName" width="150" height="112" loading="lazy" />
                <p>@L["Footer.About"]</p>
                @if (settings.GetSocialLinks().Any())
                {
                    <p class="footer-label">@L["Footer.Follow"]</p>
                    <ul class="social-list">
                        @foreach (var (_, url, label) in settings.GetSocialLinks())
                        {
                            <li><a href="@url" target="_blank" rel="noopener" aria-label="@label">@ViewHelpers.Icon(label.ToLowerInvariant())</a></li>
                        }
                    </ul>
                }
            </div>
            <div>
                <p class="footer-title">@L["Footer.Products"]</p>
                <ul class="footer-links">
                    @foreach (var category in categories)
                    {
                        <li><a href="@Url.Localized(SiteRoutes.ProductCategory, category.Slug)">@category.Name</a></li>
                    }
                </ul>
            </div>
            <div>
                <p class="footer-title">@L["Footer.Corporate"]</p>
                <ul class="footer-links">
                    <li><a href="@Url.Localized(SiteRoutes.About)">@L["Nav.AboutUs"]</a></li>
                    @if (hasServices)
                    {
                        <li><a href="@Url.Localized(SiteRoutes.Services)">@L["Nav.Services"]</a></li>
                    }
                    @if (hasCertificates)
                    {
                        <li><a href="@Url.Localized(SiteRoutes.Certificates)">@L["Nav.Certificates"]</a></li>
                    }
                    @if (hasVideos)
                    {
                        <li><a href="@Url.Localized(SiteRoutes.Videos)">@L["Nav.Videos"]</a></li>
                    }
                    @if (hasManuals)
                    {
                        <li><a href="@Url.Localized(SiteRoutes.Manuals)">@L["Nav.Manuals"]</a></li>
                    }
                    @if (hasBlog)
                    {
                        <li><a href="@Url.Localized(SiteRoutes.Blog)">@L["Nav.Blog"]</a></li>
                    }
                    <li><a href="@Url.Localized(SiteRoutes.Quote)">@L["Common.RequestQuote"]</a></li>
                </ul>
            </div>
            <div>
                <p class="footer-title">@L["Footer.Contact"]</p>
                <address class="footer-contact">
                    <p>@ViewHelpers.Icon("map-pin")<span>@settings.GetAddress(lang)</span></p>
                    <p>@ViewHelpers.Icon("phone")<a href="@phoneHref">@settings.Phone</a></p>
                    <p>@ViewHelpers.Icon("mail")<a href="mailto:@settings.Email">@settings.Email</a></p>
                    <p>@ViewHelpers.Icon("clock")<span>@settings.GetWorkingHours(lang)</span></p>
                </address>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container footer-bottom-inner">
                <p>© @DateTime.UtcNow.Year @settings.CompanyName @L["Footer.Rights"]</p>
                <ul class="footer-legal">
                    <li><a href="@Url.Localized(SiteRoutes.Privacy)">@L["Legal.PrivacyTitle"]</a></li>
                    <li><a href="@Url.Localized(SiteRoutes.Cookies)">@L["Legal.CookiesTitle"]</a></li>
                    <li><button type="button" class="link-button" data-cookie-settings>@L["Cookie.Settings"]</button></li>
                </ul>
            </div>
        </div>
    </footer>

    @if (whatsAppHref is not null)
    {
        <a href="@whatsAppHref" class="whatsapp-float" target="_blank" rel="noopener" aria-label="@L["Common.WhatsApp"]" title="@L["Common.WhatsApp"]" data-whatsapp>@ViewHelpers.Icon("whatsapp")</a>
    }

    <nav class="mobile-bar" aria-label="@L["MobileBar.Label"]">
        <a href="@phoneHref">@ViewHelpers.Icon("phone")<span>@L["Nav.Call"]</span></a>
        @if (whatsAppHref is not null)
        {
            <a href="@whatsAppHref" target="_blank" rel="noopener" data-whatsapp>@ViewHelpers.Icon("whatsapp")<span>WhatsApp</span></a>
        }
        <a href="@quoteHref" class="is-primary">@ViewHelpers.Icon("send")<span>@L["Nav.Quote"]</span></a>
    </nav>

    @if (popup is not null)
    {
        <div class="announcement-popup" role="dialog" aria-modal="true" aria-labelledby="announcementPopupText" data-announcement="@($"{popup.Id}-{popup.Version}")" data-popup hidden>
            <div class="announcement-popup-backdrop" data-announcement-close></div>
            <div class="announcement-popup-box" tabindex="-1">
                <button type="button" class="icon-button announcement-popup-close" data-announcement-close aria-label="@L["Announcement.Close"]">@ViewHelpers.Icon("x")</button>
                @if (popup.Image is not null)
                {
                    <img src="@popup.Image" alt="" class="announcement-popup-image" loading="lazy" />
                }
                <div class="announcement-popup-body">
                    <p class="eyebrow">@L["Announcement.Label"]</p>
                    <p class="announcement-popup-text" id="announcementPopupText">@popup.Message</p>
                    <div class="announcement-popup-actions">
                        @if (popup.LinkUrl is not null)
                        {
                            <a href="@popup.LinkUrl" class="btn btn-primary" target="@(IsExternal(popup.LinkUrl) ? "_blank" : null)" rel="@(IsExternal(popup.LinkUrl) ? "noopener" : null)">@(popup.LinkText ?? L["Announcement.More"].Value)</a>
                        }
                        <button type="button" class="btn btn-ghost" data-announcement-close>@L["Announcement.Dismiss"]</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="cookie-banner" id="cookieBanner" data-analytics-id="@settings.GoogleAnalyticsId" role="region" aria-label="@L["Cookie.Settings"]" hidden>
        <div class="container cookie-inner">
            <p>@L["Cookie.Message"] <a href="@Url.Localized(SiteRoutes.Cookies)">@L["Cookie.Details"]</a></p>
            <div class="cookie-actions">
                <button type="button" class="btn btn-ghost-light" data-cookie-reject>@L["Cookie.Reject"]</button>
                <button type="button" class="btn btn-primary" data-cookie-accept>@L["Cookie.Accept"]</button>
            </div>
        </div>
    </div>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
