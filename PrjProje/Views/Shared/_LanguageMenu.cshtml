@model PageSeo
@{
    var lang = Languages.Current;
}
<details class="lang-menu" data-dropdown>
    <summary aria-label="@L["Common.Language"]: @Languages.DisplayName(lang)">
        <img src="~/images/flags/@(Languages.Flag(lang)).svg" alt="" width="20" height="15" /><span>@lang.ToUpperInvariant()</span>@ViewHelpers.Icon("chevron-down")
    </summary>
    <ul>
        @foreach (var code in Languages.All)
        {
            <li>
                <a href="@Model.LanguageLinks.GetValueOrDefault(code, SiteRoutes.Path(SiteRoutes.Home, code))" hreflang="@code" lang="@code" aria-current="@(code == lang ? "true" : null)">
                    <img src="~/images/flags/@(Languages.Flag(code)).svg" alt="" width="20" height="15" />@Languages.DisplayName(code)
                </a>
            </li>
        }
    </ul>
</details>
