@model BlogPostListItemDto
@{
    var url = Url.Localized(SiteRoutes.BlogDetail, Model.Slug);
}
<article class="card" style="position: relative">
    <div class="card-media">
        @if (Model.CoverImage is not null)
        {
            <img src="@ViewHelpers.SmallImage(Model.CoverImage)" srcset="@ViewHelpers.SrcSet(Model.CoverImage)" sizes="(max-width: 640px) 100vw, 33vw"
                 alt="" loading="lazy" decoding="async" width="640" height="480" />
        }
        else
        {
            @ViewHelpers.Icon("file-text")
        }
    </div>
    <div class="card-body">
        <p class="post-meta">
            <time datetime="@Model.PublishedDate.ToString("yyyy-MM-dd")">@Model.PublishedDate.ToLocalTime().ToString("d MMMM yyyy")</time>
            @if (Model.CategoryName is not null)
            {
                <span>· @Model.CategoryName</span>
            }
        </p>
        <h3 class="card-title"><a href="@url">@Model.Title</a></h3>
        @if (!string.IsNullOrEmpty(Model.Summary))
        {
            <p class="card-text">@ViewHelpers.Truncate(Model.Summary, 150)</p>
        }
        <div class="card-meta"><span class="link-arrow">@L["Common.ReadMore"] @ViewHelpers.Icon("arrow-right")</span></div>
    </div>
</article>
