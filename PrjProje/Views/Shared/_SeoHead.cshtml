@using System.Text.Json
@model PageSeo
@inject PrjProje.Application.Interfaces.ISiteSettingsService SettingsService
@{
    var settings = await SettingsService.GetAsync();
    var lang = Languages.Current;
    var title = Model.Title.Contains("PRJ Proje Makina", StringComparison.OrdinalIgnoreCase) ? Model.Title : $"{Model.Title} | PRJ Proje Makina";
    // Keep titles in the 30–60 char range search results display in full.
    var richTitle = $"{Model.Title} | {L["Seo.TitleSuffix"]}";
    if (title.Length < 30 && title != Model.Title && richTitle.Length <= 60) title = richTitle;
    else if (title.Length > 60 && title != Model.Title) title = Model.Title;
    var description = ViewHelpers.Truncate(Model.Description ?? L["Home.MetaDescription"], 165);
    var canonical = Url.Absolute(Model.CanonicalPath);
    var image = Url.Absolute(Model.Image ?? "/images/logo.png");

    var organization = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Organization",
        ["name"] = settings.CompanyName,
        ["url"] = Url.Absolute(SiteRoutes.Path(SiteRoutes.Home, lang)),
        ["logo"] = Url.Absolute("/images/logo.png"),
        ["email"] = settings.Email,
        ["telephone"] = settings.Phone,
        ["address"] = new Dictionary<string, object>
        {
            ["@type"] = "PostalAddress",
            ["streetAddress"] = settings.GetAddress(lang),
            ["addressLocality"] = "Sincan",
            ["addressRegion"] = "Ankara",
            ["addressCountry"] = "TR"
        },
        ["sameAs"] = settings.GetSocialLinks().Select(s => s.Url).ToArray()
    };

    var structuredData = new List<object> { organization };
    if (Model.Breadcrumbs.Count > 0)
    {
        structuredData.Add(new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = Model.Breadcrumbs.Select((item, index) => new Dictionary<string, object?>
            {
                ["@type"] = "ListItem",
                ["position"] = index + 1,
                ["name"] = item.Title,
                ["item"] = Url.Absolute(item.Url ?? Model.CanonicalPath)
            }).ToArray()
        });
    }

    structuredData.AddRange(Model.StructuredData);
    var jsonOptions = new JsonSerializerOptions { DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull };
}
<title>@title</title>
<meta name="description" content="@description" />
<meta name="robots" content="@(Model.NoIndex ? "noindex,follow" : "index,follow,max-image-preview:large")" />
@if (!string.IsNullOrWhiteSpace(settings.GoogleSiteVerification))
{
    <meta name="google-site-verification" content="@settings.GoogleSiteVerification" />
}
<link rel="canonical" href="@canonical" />
@foreach (var (code, path) in Model.Alternates)
{
    <link rel="alternate" hreflang="@code" href="@Url.Absolute(path)" />
}
@if (Model.Alternates.TryGetValue(Languages.Default, out var defaultPath))
{
    <link rel="alternate" hreflang="x-default" href="@Url.Absolute(defaultPath)" />
}
<meta property="og:site_name" content="PRJ Proje Makina" />
<meta property="og:type" content="@Model.OpenGraphType" />
<meta property="og:title" content="@title" />
<meta property="og:description" content="@description" />
<meta property="og:url" content="@canonical" />
<meta property="og:image" content="@image" />
<meta property="og:locale" content="@Languages.OpenGraphLocale(lang)" />
@foreach (var code in Model.Alternates.Keys.Where(c => c != lang))
{
    <meta property="og:locale:alternate" content="@Languages.OpenGraphLocale(code)" />
}
@if (Model.PublishedTime.HasValue)
{
    <meta property="article:published_time" content="@Model.PublishedTime.Value.ToString("O")" />
}
@if (Model.ModifiedTime.HasValue)
{
    <meta property="article:modified_time" content="@Model.ModifiedTime.Value.ToString("O")" />
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="@title" />
<meta name="twitter:description" content="@description" />
<meta name="twitter:image" content="@image" />
@foreach (var item in structuredData)
{
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(item, jsonOptions))</script>
}
