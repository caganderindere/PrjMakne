@model HomeViewModel
@{
    var heroImage = Model.HeroImage ?? Model.FeaturedProducts.FirstOrDefault(p => p.Image is not null)?.Image;
    var reasons = Enumerable.Range(1, 6);
    var aboutImage = Model.FeaturedProducts.Skip(1).FirstOrDefault(p => p.Image is not null)?.Image ?? heroImage;
    var whyImage = Model.FeaturedProducts.Skip(2).FirstOrDefault(p => p.Image is not null)?.Image ?? aboutImage;
    var aboutPoints = Enumerable.Range(1, 3);
    var questions = Enumerable.Range(1, 4);
}
@* Hero: a scroll-driven powder coating line drawn with three.js (js/hero3d.js). Parts ride the overhead conveyor
   into the booth bare, get coated, cure in the oven and leave glossy red. Without WebGL the plant photo stays. *@
<section class="hero-line" data-paint-line aria-labelledby="hero-title">
    <h1 id="hero-title" class="visually-hidden">@L["Home.HeroTitle"] @L["Home.HeroTitleAccent"]</h1>
    <div class="hero-line-stage">
        <img class="hero-line-poster" src="~/images/hero/poster.webp" alt="@L["Home.LineAlt"]" width="1600" height="1200" fetchpriority="high" />
        <div class="hero-line-canvas" role="img" aria-label="@L["Home.LineAlt"]"></div>
        <ol class="hero-line-steps">
            @for (var step = 1; step <= 4; step++)
            {
                <li><span>0@(step)</span> @L[$"Home.LineStep{step}"]</li>
            }
        </ol>
        <p class="hero-line-hint" aria-hidden="true">@L["Home.LineHint"] @ViewHelpers.Icon("chevron-down")</p>
    </div>
</section>


<section class="section">
    <div class="container split">
        <div data-reveal>
            <p class="eyebrow">@L["Nav.About"]</p>
            <h2>@L["Home.AboutTitle"]</h2>
            <p class="lead">@L["Home.AboutLead"]</p>
            <p>@L["Home.AboutText"]</p>
            <ul class="check-list">
                @foreach (var point in aboutPoints)
                {
                    <li>@ViewHelpers.Icon("circle-check") <span>@L[$"Home.AboutPoint{point}"]</span></li>
                }
            </ul>
            <div class="button-row">
                <a href="@Url.Localized(SiteRoutes.About)" class="btn btn-outline">@L["Home.LearnMore"]</a>
            </div>
        </div>
        @if (aboutImage is not null)
        {
            <div class="about-media" data-reveal>
                <img src="@ViewHelpers.SmallImage(aboutImage)" srcset="@ViewHelpers.SrcSet(aboutImage)" sizes="(max-width: 900px) 100vw, 50vw" alt="@L["Home.ModelAlt"]" loading="lazy" decoding="async" width="960" height="720" />
            </div>
        }
    </div>
</section>

@if (Model.Categories.Count > 0)
{
    <section class="section section-dark">
        <div class="container">
            <div class="section-head" data-reveal>
                <div>
                    <p class="eyebrow">@L["Nav.Products"]</p>
                    <h2>@L["Home.CategoriesTitle"]</h2>
                    <p>@L["Home.CategoriesLead"]</p>
                </div>
                <a href="@Url.Localized(SiteRoutes.Products)" class="link-arrow">@L["Products.AllProducts"] @ViewHelpers.Icon("arrow-right")</a>
            </div>
            <div class="grid grid-4 rail-mobile" data-reveal="items">
                @foreach (var category in Model.Categories)
                {
                    <partial name="_CategoryCard" model="category" />
                }
            </div>
        </div>
    </section>
}

@if (Model.Services.Count > 0)
{
    <section class="section section-steel">
        <div class="container">
            <div class="section-head" data-reveal>
                <div>
                    <p class="eyebrow">@L["Nav.Services"]</p>
                    <h2>@L["Home.ServicesTitle"]</h2>
                    <p>@L["Home.ServicesLead"]</p>
                </div>
                <a href="@Url.Localized(SiteRoutes.Services)" class="link-arrow">@L["Home.AllServices"] @ViewHelpers.Icon("arrow-right")</a>
            </div>
            <div class="service-grid service-grid-4 rail-mobile" data-reveal="items">
                @foreach (var service in Model.Services)
                {
                    <article class="service-card">
                        @if (service.Image is not null)
                        {
                            <img src="@ViewHelpers.SmallImage(service.Image)" srcset="@ViewHelpers.SrcSet(service.Image)" sizes="(max-width: 768px) 80vw, 25vw" alt="" loading="lazy" decoding="async" width="640" height="480" />
                        }
                        <h3><a href="@Url.Localized(SiteRoutes.ServiceDetail, service.Slug)">@service.Title</a></h3>
                        <p>@service.Summary</p>
                    </article>
                }
            </div>
        </div>
    </section>
}

<section class="section section-dark">
    <div class="container">
        <div class="section-head" data-reveal>
            <div>
                <p class="eyebrow">@L["Home.ProcessEyebrow"]</p>
                <h2>@L["Home.ProcessTitle"]</h2>
                <p>@L["Home.ProcessLead"]</p>
            </div>
            <a href="@Url.Localized(SiteRoutes.Services)" class="btn btn-ghost-light">@L["Home.AllServices"]</a>
        </div>
        <partial name="_ProcessTimeline" />
    </div>
</section>

<section class="section">
    <div class="container why-split">
        @if (whyImage is not null)
        {
            <div class="about-media" data-reveal>
                <img src="@ViewHelpers.SmallImage(whyImage)" srcset="@ViewHelpers.SrcSet(whyImage)" sizes="(max-width: 900px) 100vw, 50vw" alt="@L["Home.WhyImageAlt"]" loading="lazy" decoding="async" width="960" height="720" />
            </div>
        }
        <div class="why-text" data-reveal>
            <p class="eyebrow">@L["Home.WhyEyebrow"]</p>
            <h2>@L["Home.WhyTitle"]</h2>
            <p class="lead">@L["Home.WhyLead"]</p>
            @foreach (var reason in reasons)
            {
                <h3>@L[$"Home.Why{reason}Title"]</h3>
                <p>@L[$"Home.Why{reason}Text"]</p>
            }
        </div>
    </div>
</section>

@if (Model.FeaturedProducts.Count > 0)
{
    <section class="section section-steel">
        <div class="container">
            <div class="section-head" data-reveal>
                <div>
                    <p class="eyebrow">@L["Home.FeaturedEyebrow"]</p>
                    <h2>@L["Home.FeaturedTitle"]</h2>
                    <p>@L["Home.FeaturedLead"]</p>
                </div>
                <a href="@Url.Localized(SiteRoutes.Products)" class="link-arrow">@L["Products.AllProducts"] @ViewHelpers.Icon("arrow-right")</a>
            </div>
            <div class="grid grid-4 rail-mobile" data-reveal="items">
                @foreach (var product in Model.FeaturedProducts)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </div>
    </section>
}

@if (Model.Videos.Count > 0)
{
    <section class="section section-dark">
        <div class="container">
            <div class="section-head" data-reveal>
                <div>
                    <p class="eyebrow">@L["Nav.Videos"]</p>
                    <h2>@L["Home.VideoTitle"]</h2>
                </div>
                <a href="@Url.Localized(SiteRoutes.Videos)" class="link-arrow">@L["Home.AllVideos"] @ViewHelpers.Icon("arrow-right")</a>
            </div>
            <div class="grid grid-3" data-reveal="items">
                @foreach (var video in Model.Videos)
                {
                    <partial name="_Video" model="video" />
                }
            </div>
        </div>
    </section>
}

@if (Model.References.Count > 0)
{
    <section class="section section-steel">
        <div class="container">
            <div class="section-head" data-reveal>
                <div>
                    <p class="eyebrow">@L["Home.ReferencesEyebrow"]</p>
                    <h2>@L["Home.ReferencesTitle"]</h2>
                    <p>@L["Home.ReferencesLead"]</p>
                </div>
                <a href="@Url.Localized(SiteRoutes.Certificates)" class="link-arrow">@L["Nav.Certificates"] @ViewHelpers.Icon("arrow-right")</a>
            </div>
            <div class="reference-strip">
                @foreach (var reference in Model.References)
                {
                    if (reference.WebsiteUrl is not null)
                    {
                        <a href="@reference.WebsiteUrl" target="_blank" rel="noopener nofollow"><img src="@reference.Logo" alt="@reference.Name" loading="lazy" decoding="async" width="160" height="56" /></a>
                    }
                    else
                    {
                        <span><img src="@reference.Logo" alt="@reference.Name" loading="lazy" decoding="async" width="160" height="56" /></span>
                    }
                }
            </div>
        </div>
    </section>
}

<section class="section">
    <div class="container split">
        <div data-reveal>
            <p class="eyebrow">@L["Home.FaqEyebrow"]</p>
            <h2>@L["Home.FaqTitle"]</h2>
            <p>@L["Home.FaqLead"]</p>
            <a href="@Url.Localized(SiteRoutes.Contact)" class="link-arrow">@L["Home.FaqContact"] @ViewHelpers.Icon("arrow-right")</a>
        </div>
        <div class="faq">
            @foreach (var question in questions)
            {
                <details>
                    <summary>@L[$"Home.Faq{question}Question"] @ViewHelpers.Icon("chevron-down")</summary>
                    <p>@L[$"Home.Faq{question}Answer"]</p>
                </details>
            }
        </div>
    </div>
</section>

@if (Model.LatestPosts.Count > 0)
{
    <section class="section section-steel">
        <div class="container">
            <div class="section-head" data-reveal>
                <div>
                    <p class="eyebrow">@L["Home.BlogEyebrow"]</p>
                    <h2>@L["Home.BlogTitle"]</h2>
                    <p>@L["Home.BlogLead"]</p>
                </div>
                <a href="@Url.Localized(SiteRoutes.Blog)" class="link-arrow">@L["Home.AllPosts"] @ViewHelpers.Icon("arrow-right")</a>
            </div>
            <div class="home-blog" data-reveal="items">
                @foreach (var post in Model.LatestPosts)
                {
                    <partial name="_BlogCard" model="post" />
                }
            </div>
        </div>
    </section>
}

<partial name="_CtaSection" />

@section Scripts {
    <script type="module" src="~/js/hero3d.js" asp-append-version="true"></script>
}
