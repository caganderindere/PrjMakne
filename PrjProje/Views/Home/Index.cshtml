@model HomeViewModel
@{
    var heroImage = string.IsNullOrWhiteSpace(Model.HeroImage) ? null : Model.HeroImage;
    var processSteps = new[]
    {
        (Icon: "fa-solid fa-compass-drafting", Index: 1),
        (Icon: "fa-solid fa-fire-flame-curved", Index: 2),
        (Icon: "fa-solid fa-gear", Index: 3),
        (Icon: "fa-solid fa-clipboard-check", Index: 4),
        (Icon: "fa-solid fa-truck-fast", Index: 5)
    };
    var reasons = new[]
    {
        (Icon: "fa-solid fa-industry", Index: 1),
        (Icon: "fa-solid fa-stopwatch", Index: 2),
        (Icon: "fa-solid fa-ruler-combined", Index: 3),
        (Icon: "fa-solid fa-user-gear", Index: 4),
        (Icon: "fa-solid fa-shield-halved", Index: 5),
        (Icon: "fa-solid fa-ship", Index: 6)
    };
    var industries = new[]
    {
        (Icon: "fa-solid fa-truck-monster", Index: 1),
        (Icon: "fa-solid fa-helmet-safety", Index: 2),
        (Icon: "fa-solid fa-tractor", Index: 3),
        (Icon: "fa-solid fa-shield-halved", Index: 4),
        (Icon: "fa-solid fa-road", Index: 5),
        (Icon: "fa-solid fa-gears", Index: 6)
    };
    var stats = Model.Stats;
    string Number(int value) => value.ToString("N0", System.Globalization.CultureInfo.CurrentCulture);
    var countryCount = Math.Max(stats.Countries, Model.ExportCountryCodes.Count);
    var exportRegions = ExportRegions.Group(Model.ExportCountryCodes);
    var hasDesktopVideo = Model.HeroVideo is not null;
    var hasMobileVideo = Model.HeroVideoMobile is not null;
    var hasVideo = hasDesktopVideo || hasMobileVideo;
}
@section Head {
    <link rel="stylesheet" href="~/css/hero-3d.css" asp-append-version="true" />
    @* Desktop (992px+) shows the 3D stage instead of the photo, so the photo is only preloaded below that. *@
    @if (heroImage is not null)
    {
        <link rel="preload" as="image" href="@heroImage" media="@(hasMobileVideo ? "(min-width: 768px) and (max-width: 991.98px)" : "(max-width: 991.98px)")" fetchpriority="high" />
    }
    else
    {
        @if (!hasMobileVideo)
        {
            <link rel="preload" as="image" href="~/images/hero-1080.jpg" media="(max-width: 767.98px)" fetchpriority="high" />
        }
        <link rel="preload" as="image" href="~/images/hero-1920.jpg" media="(min-width: 768px) and (max-width: 991.98px)" fetchpriority="high" />
    }
}

<div class="home-page">
@* An image uploaded from the admin settings overrides the default facility photo. *@
@* The track gives the hero a short pinned scroll on desktop, during which the 3D mount is pressed down (hero-3d.css). *@
<div class="hero-track">
<section class="hero hero-3d hero-has-image @(heroImage is null ? "hero-facility" : null) @(hasVideo && !hasDesktopVideo ? "hero-photo-desktop" : null) @(hasMobileVideo ? "hero-video-mobile" : null)" style="@(heroImage is null ? null : $"--hero-image:url('{heroImage}')")">
    <div class="hero-bg" aria-hidden="true"></div>
    @if (hasVideo)
    {
        <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="@(heroImage ?? "/images/hero-1080.jpg")" aria-hidden="true" data-hero-video>
            @if (hasMobileVideo)
            {
                <source src="@Model.HeroVideoMobile" type="video/mp4" media="(max-width: 767.98px)" />
            }
            @if (hasDesktopVideo)
            {
                <source src="@Model.HeroVideo" type="video/mp4" />
            }
        </video>
        <div class="hero-shade" aria-hidden="true"></div>
        <button type="button" class="video-toggle" aria-pressed="false" data-video-toggle data-label-pause="@L["Home.VideoPause"]" data-label-play="@L["Home.VideoPlay"]" aria-label="@L["Home.VideoPause"]">
            <span class="video-toggle-icon" aria-hidden="true"></span>
        </button>
    }
    <div class="hero-lines" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="container hero-content">
        <span class="eyebrow eyebrow-light hero-anim" style="--d:0">@L["Home.HeroEyebrow"]</span>
        <h1 class="hero-title hero-anim" style="--d:1">@L["Home.HeroTitle"] <span class="hero-title-accent">@L["Home.HeroTitleAccent"]</span></h1>
        <p class="hero-lead hero-anim" style="--d:2">@L["Home.HeroSubtitle"]</p>
        <div class="d-flex flex-wrap gap-3 hero-actions hero-anim" style="--d:3">
            <a href="@Url.Localized(SiteRoutes.Products)" class="btn btn-brand btn-lg">@L["Home.ExploreProducts"] <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i></a>
            <a href="@Url.Localized(SiteRoutes.Quote)" class="btn btn-outline-light btn-lg">@L["Common.RequestQuote"]</a>
        </div>
        <ul class="hero-badges list-unstyled hero-anim" style="--d:4">
            <li><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>@L["Common.SecurityClearance"]</li>
            <li><i class="fa-solid fa-industry" aria-hidden="true"></i>@L["Home.BadgeInHouse"]</li>
            <li><i class="fa-solid fa-earth-europe" aria-hidden="true"></i>@L["Home.BadgeExport"]</li>
        </ul>
    </div>
    @* Desktop: a rubber-to-metal mount in 3D (hero-3d.js / hero-3d.css). Hidden below 992px, where nothing of it loads. *@
    <div class="hero-stage" data-hero-stage>
        <canvas class="hero-stage-canvas" role="img" aria-label="@L["Home.ModelAlt"]"></canvas>
    </div>
    <div class="hero-scroll d-none d-md-block" aria-hidden="true"><span></span></div>
</section>
</div>

<section class="stats-bar" aria-label="@L["Home.StatsLabel"]">
    <div class="container">
        <div class="row g-0">
            <div class="col-6 col-lg-3 stat-item">
                <i class="fa-solid fa-warehouse stat-icon" aria-hidden="true"></i>
                <div class="stat-value"><span data-count="@stats.Facility">@Number(stats.Facility)</span><small>m²</small></div>
                <div class="stat-label">@L["Stats.Facility"]</div>
            </div>
            <div class="col-6 col-lg-3 stat-item">
                <i class="fa-solid fa-people-group stat-icon" aria-hidden="true"></i>
                <div class="stat-value"><span data-count="@stats.Employees">@Number(stats.Employees)</span><small>+</small></div>
                <div class="stat-label">@L["Stats.Employees"]</div>
            </div>
            <div class="col-6 col-lg-3 stat-item">
                <i class="fa-solid fa-earth-europe stat-icon" aria-hidden="true"></i>
                <div class="stat-value"><span data-count="@stats.Countries">@Number(stats.Countries)</span><small>+</small></div>
                <div class="stat-label">@L["Stats.Countries"]</div>
            </div>
            <div class="col-6 col-lg-3 stat-item">
                <i class="fa-solid fa-flag stat-icon" aria-hidden="true"></i>
                <div class="stat-value"><small>%</small><span data-count="@stats.Domestic">@Number(stats.Domestic)</span></div>
                <div class="stat-label">@L["Stats.Domestic"]</div>
            </div>
        </div>
    </div>
</section>

@* Order and visibility of these sections are set in Admin > Site Ayarları > Ana Sayfa Bölümleri. *@
@foreach (var section in Model.Sections)
{
    if (section == "about")
    {
        <section class="section">
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6">
                        <div class="about-visual reveal-left">
                            <img src="~/images/hero-1080.jpg" alt="@L["Home.AboutVisualCaption"]" class="about-visual-main" width="1080" height="810" loading="lazy" decoding="async" />
                            <img src="~/images/categories/celik.jpg" alt="" class="about-visual-sub" width="960" height="640" loading="lazy" decoding="async" />
                            <div class="about-visual-card">
                                <span class="about-visual-number"><span data-count="@stats.Facility">@Number(stats.Facility)</span> m²</span>
                                <span>@L["Home.AboutVisualCaption"]</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <span class="eyebrow">@L["Nav.About"]</span>
                        <h2 class="section-title">@L["Home.AboutTitle"]</h2>
                        <p class="lead-text">@L["Home.AboutLead"]</p>
                        <p>@L["Home.AboutText"]</p>
                        <ul class="check-list">
                            <li>@L["Home.AboutPoint1"]</li>
                            <li>@L["Home.AboutPoint2"]</li>
                            <li>@L["Home.AboutPoint3"]</li>
                        </ul>
                        <a href="@Url.Localized(SiteRoutes.About)" class="btn btn-dark btn-lg mt-2">@L["Home.LearnMore"] <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i></a>
                    </div>
                </div>
            </div>
        </section>
    }
    else if (section == "categories" && Model.Categories.Count > 0)
    {
        <section class="section section-light">
            <div class="container">
                <div class="section-heading">
                    <div>
                        <span class="eyebrow">@L["Nav.Products"]</span>
                        <h2 class="section-title">@L["Home.CategoriesTitle"]</h2>
                    </div>
                    <a href="@Url.Localized(SiteRoutes.Products)" class="link-arrow">@L["Products.AllProducts"] <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                </div>
                <div class="row g-4 category-grid home-scroller" data-stagger>
                    @foreach (var (category, categoryIndex) in Model.Categories.Select((c, i) => (c, i)))
                    {
                        <div class="col-sm-6 col-lg-4 col-xl">
                            <a href="@Url.Localized(SiteRoutes.ProductCategory, category.Slug)" class="category-card h-100">
                                @if (category.Image is not null)
                                {
                                    var srcSet = ViewHelpers.SrcSet(category.Image);
                                    <span class="category-media">
                                        <img src="@ViewHelpers.SmallImage(category.Image)" srcset="@(srcSet == category.Image ? null : srcSet)" sizes="(min-width: 576px) 50vw, 100vw" alt="@category.Name" width="640" height="427" loading="lazy" decoding="async" />
                                    </span>
                                }
                                <span class="category-index" aria-hidden="true">@((categoryIndex + 1).ToString("00"))</span>
                                <span class="category-body">
                                    @if (category.Image is null)
                                    {
                                        @* Fallback while a category has no image yet. *@
                                        <span class="category-icon"><i class="@category.IconClass" aria-hidden="true"></i></span>
                                    }
                                    <h3 class="category-title">@category.Name</h3>
                                    <p class="category-text">@ViewHelpers.Truncate(category.Description, 110)</p>
                                    <span class="category-link">@L["Common.Explore"] <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
                                </span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else if (section == "capabilities" && Model.Capabilities.Count > 0)
    {
        <section class="section">
            <div class="container">
                <div class="section-heading">
                    <div>
                        <span class="eyebrow">@L["Nav.Manufacturing"]</span>
                        <h2 class="section-title">@L["Home.CapabilitiesTitle"]</h2>
                        <p class="section-lead">@L["Home.CapabilitiesLead"]</p>
                    </div>
                    <a href="@Url.Localized(SiteRoutes.Manufacturing)" class="link-arrow">@L["Home.AllCapabilities"] <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                </div>
                <div class="row g-0 capability-grid" data-stagger>
                    @foreach (var capability in Model.Capabilities)
                    {
                        <div class="col-sm-6 col-lg-3">
                            <a href="@Url.Localized(SiteRoutes.ManufacturingDetail, capability.Slug)" class="capability-card h-100">
                                <i class="@capability.IconClass capability-icon" aria-hidden="true"></i>
                                <h3 class="capability-title">@capability.Title</h3>
                                <p class="capability-text">@capability.Summary</p>
                                <span class="capability-arrow" aria-hidden="true"><i class="fa-solid fa-arrow-right"></i></span>
                                <span class="capability-more" aria-hidden="true">@L["Common.Explore"] <i class="fa-solid fa-arrow-right"></i></span>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else if (section == "process")
    {
        <section class="section section-dark process-section">
            <div class="container process-layout" data-process>
                <div class="process-head">
                    <span class="eyebrow eyebrow-light">@L["Home.ProcessEyebrow"]</span>
                    <h2 class="section-title text-white">@L["Home.ProcessTitle"]</h2>
                    <p class="process-lead">@L["Home.ProcessLead"]</p>
                </div>
                <div class="process-stage" aria-hidden="true">
                    <div class="process-ring">
                        <svg viewBox="0 0 120 120"><circle class="process-ring-track" cx="60" cy="60" r="54" /><circle class="process-ring-fill" cx="60" cy="60" r="54" pathLength="100" /></svg>
                        <div class="process-prism">
                            @foreach (var step in processSteps)
                            {
                                <i class="@step.Icon process-stage-icon" data-step="@step.Index" style="--step:@(step.Index - 1)"></i>
                            }
                        </div>
                    </div>
                    <div class="process-stage-info">
                        <span class="process-stage-count">@L["Home.ProcessStep"] <b data-process-count>01</b> / @processSteps.Length.ToString("00")</span>
                        <span class="process-stage-titles">
                            @foreach (var step in processSteps)
                            {
                                <span class="process-stage-title" data-step="@step.Index">@L[$"Home.Process{step.Index}Title"]</span>
                            }
                        </span>
                        <span class="process-stage-dots">
                            @foreach (var step in processSteps)
                            {
                                <span data-step="@step.Index"></span>
                            }
                        </span>
                    </div>
                </div>
                <div class="process-timeline">
                    <span class="process-rail" aria-hidden="true"><span class="process-rail-fill"></span></span>
                    <ol class="process-steps list-unstyled">
                        @foreach (var step in processSteps)
                        {
                            <li class="process-step" data-step="@step.Index">
                                <span class="process-step-marker"><i class="@step.Icon" aria-hidden="true"></i></span>
                                <div class="process-step-body">
                                    <span class="process-step-number">@step.Index.ToString("00")</span>
                                    <h3>@L[$"Home.Process{step.Index}Title"]</h3>
                                    <p>@L[$"Home.Process{step.Index}Text"]</p>
                                </div>
                            </li>
                        }
                    </ol>
                </div>
            </div>
        </section>
    }
    else if (section == "featured" && Model.FeaturedProducts.Count > 0)
    {
        <section class="section section-light">
            <div class="container">
                <div class="section-heading">
                    <div>
                        <span class="eyebrow">@L["Home.FeaturedEyebrow"]</span>
                        <h2 class="section-title">@L["Home.FeaturedTitle"]</h2>
                        <p class="section-lead">@L["Home.FeaturedLead"]</p>
                    </div>
                    <a href="@Url.Localized(SiteRoutes.Products)" class="link-arrow">@L["Products.AllProducts"] <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                </div>
                @* Same search as the products page (name, material, OEM no, service code); results open there. *@
                <div class="home-search">
                    <partial name="_ProductSearchForm" model='new ProductSearchFormModel(Url.Localized(SiteRoutes.Products), "homeSearch")' />
                </div>
                <div class="row g-4 home-scroller" data-stagger>
                    @foreach (var product in Model.FeaturedProducts)
                    {
                        <div class="col-sm-6 col-lg-3">
                            <partial name="_ProductCard" model="product" />
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else if (section == "why")
    {
        <section class="section section-light why-section">
            <div class="container">
                <div class="row g-5 align-items-start">
                    <div class="col-lg-4">
                        <div class="why-intro">
                            <span class="eyebrow">@L["Home.WhyEyebrow"]</span>
                            <h2 class="section-title">@L["Home.WhyTitle"]</h2>
                            <p class="section-lead mb-4">@L["Home.AboutText"]</p>
                            <a href="@Url.Localized(SiteRoutes.Quote)" class="btn btn-brand btn-lg">@L["Common.RequestQuote"]</a>
                        </div>
                    </div>
                    <div class="col-lg-8">
                        <div class="row g-4" data-stagger>
                            @foreach (var reason in reasons)
                            {
                                <div class="col-sm-6">
                                    <div class="why-card h-100">
                                        <span class="why-number">@reason.Index.ToString("00")</span>
                                        <i class="@reason.Icon why-icon" aria-hidden="true"></i>
                                        <h3>@L[$"Home.Why{reason.Index}Title"]</h3>
                                        <p>@L[$"Home.Why{reason.Index}Text"]</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
    else if (section == "references" && Model.References.Count > 0)
    {
        <section class="section references-section">
            <div class="container">
                <div class="section-heading justify-content-center text-center">
                    <div>
                        <span class="eyebrow">@L["Home.ReferencesEyebrow"]</span>
                        <h2 class="section-title">@L["Home.ReferencesTitle"]</h2>
                        <p class="section-lead mx-auto">@L["Home.ReferencesLead"]</p>
                    </div>
                </div>
                <ul class="references-list list-unstyled" data-references-slider>
                    @foreach (var reference in Model.References)
                    {
                        <li class="reference-card" title="@reference.Name">
                            @if (reference.WebsiteUrl is not null)
                            {
                                <a href="@reference.WebsiteUrl" target="_blank" rel="noopener nofollow"><img src="@reference.Logo" alt="@reference.Name" width="160" height="52" loading="lazy" decoding="async" /></a>
                            }
                            else
                            {
                                <img src="@reference.Logo" alt="@reference.Name" width="160" height="52" loading="lazy" decoding="async" />
                            }
                        </li>
                    }
                </ul>
            </div>
        </section>
    }
    else if (section == "defense")
    {
        <section class="section section-dark defense-teaser">
            <img src="~/images/categories/savunma.jpg" alt="" class="defense-bg" loading="lazy" decoding="async" aria-hidden="true" />
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-lg-7">
                        <span class="eyebrow eyebrow-light">@L["Nav.Defense"]</span>
                        <h2 class="section-title text-white">@L["Home.DefenseTitle"]</h2>
                        <p class="text-light-muted">@L["Home.DefenseText"]</p>
                        <div class="row g-3 my-4" data-stagger>
                            <div class="col-sm-6"><div class="defense-point"><i class="fa-solid fa-certificate" aria-hidden="true"></i>@L["Defense.PointClearance"]</div></div>
                            <div class="col-sm-6"><div class="defense-point"><i class="fa-solid fa-flag" aria-hidden="true"></i>@L["Defense.PointDomestic"]</div></div>
                            <div class="col-sm-6"><div class="defense-point"><i class="fa-solid fa-user-lock" aria-hidden="true"></i>@L["Defense.PointConfidentiality"]</div></div>
                            <div class="col-sm-6"><div class="defense-point"><i class="fa-solid fa-clipboard-check" aria-hidden="true"></i>@L["Defense.PointQuality"]</div></div>
                        </div>
                        <a href="@Url.Localized(SiteRoutes.Defense)" class="btn btn-brand btn-lg">@L["Common.Explore"] <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i></a>
                    </div>
                </div>
            </div>
        </section>
    }
    else if (section == "industries")
    {
        <section class="industries-band">
            <div class="container">
                <div class="row align-items-center g-4">
                    <div class="col-lg-3">
                        <span class="eyebrow">@L["Home.IndustriesEyebrow"]</span>
                        <h2 class="industries-title">@L["Home.IndustriesTitle"]</h2>
                    </div>
                    <div class="col-lg-9">
                        <ul class="industries-list list-unstyled" data-stagger>
                            @foreach (var industry in industries)
                            {
                                <li><i class="@industry.Icon" aria-hidden="true"></i><span>@L[$"Home.Industry{industry.Index}"]</span></li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </section>
    }
    else if (section == "export")
    {
        <section class="section export-section">
            <div class="container">
                <div class="row align-items-start g-5">
                    <div class="col-lg-4">
                        <span class="eyebrow">@L["Home.ExportEyebrow"]</span>
                        <h2 class="section-title">@L["Home.ExportTitle"]</h2>
                        <p>@L["Home.ExportText"]</p>
                        <div class="export-stats">
                            <div class="export-count"><span data-count="@countryCount">@countryCount</span>+ <small>@L["Stats.Countries"]</small></div>
                            <div class="export-count"><span data-count="@exportRegions.Count">@exportRegions.Count</span> <small>@L["Home.ExportRegions"]</small></div>
                        </div>
                        @if (exportRegions.Count > 1)
                        {
                            <div class="export-region-tabs" role="group" aria-label="@L["Home.ExportRegions"]">
                                <button type="button" data-region="all" aria-pressed="true">@L["Home.ExportRegion.all"] <span>@Model.ExportCountryCodes.Count</span></button>
                                @foreach (var region in exportRegions)
                                {
                                    <button type="button" data-region="@region.Key" aria-pressed="false">@L["Home.ExportRegion." + region.Key] <span>@region.Codes.Count</span></button>
                                }
                            </div>
                        }
                        <ul class="country-chips list-unstyled" data-country-names="@Languages.Current">
                            @foreach (var region in exportRegions)
                            {
                                foreach (var code in region.Codes)
                                {
                                    <li data-country="@code" data-region="@region.Key" tabindex="0">@code</li>
                                }
                            }
                        </ul>
                    </div>
                    <div class="col-lg-8">
                        <div class="export-map-frame">
                            <div class="export-map" id="exportMap" data-countries="@string.Join(",", Model.ExportCountryCodes)" role="img" aria-label="@L["Home.ExportMapLabel"]">
                                <div class="export-map-placeholder"><i class="fa-solid fa-earth-europe" aria-hidden="true"></i></div>
                            </div>
                            <div class="export-map-controls" data-map-controls hidden>
                                <button type="button" data-map-zoom="in" aria-label="@L["Home.MapZoomIn"]" title="@L["Home.MapZoomIn"]"><i class="fa-solid fa-plus" aria-hidden="true"></i></button>
                                <button type="button" data-map-zoom="out" aria-label="@L["Home.MapZoomOut"]" title="@L["Home.MapZoomOut"]"><i class="fa-solid fa-minus" aria-hidden="true"></i></button>
                                <button type="button" data-map-reset aria-label="@L["Home.MapReset"]" title="@L["Home.MapReset"]" hidden><i class="fa-solid fa-expand" aria-hidden="true"></i></button>
                            </div>
                        </div>
                        <div class="export-legend" aria-hidden="true">
                            <span><i class="legend-dot legend-origin"></i>Ankara</span>
                            <span><i class="legend-dot legend-export"></i>@L["Stats.Countries"]</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
    else if (section == "blog" && Model.LatestPosts.Count > 0)
    {
        <section class="section section-light">
            <div class="container">
                <div class="section-heading">
                    <div>
                        <span class="eyebrow">@L["Nav.Blog"]</span>
                        <h2 class="section-title">@L["Home.BlogTitle"]</h2>
                    </div>
                    <a href="@Url.Localized(SiteRoutes.Blog)" class="link-arrow">@L["Home.AllPosts"] <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
                </div>
                <div class="row g-4 home-scroller" data-stagger>
                    @foreach (var post in Model.LatestPosts)
                    {
                        <div class="col-md-6 col-lg-4">
                            <partial name="_BlogCard" model="post" />
                        </div>
                    }
                </div>
            </div>
        </section>
    }
}

<partial name="_CtaSection" />
</div>

@section Scripts {
    <script type="module" src="~/js/hero-3d.js" asp-append-version="true"></script>
    <script src="~/js/products-search.js" asp-append-version="true" defer></script>
}
