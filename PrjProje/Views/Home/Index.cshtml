@model HomeViewModel
@* Interim home page: the corporate home page is designed in the page-design step of the plan. *@
<section class="section">
    <div class="container">
        <h1>@L["Home.MetaTitle"]</h1>
        <ul>
            @foreach (var category in Model.Categories)
            {
                <li><a href="@Url.Localized(SiteRoutes.ProductCategory, category.Slug)">@category.Name</a></li>
            }
        </ul>
    </div>
</section>
