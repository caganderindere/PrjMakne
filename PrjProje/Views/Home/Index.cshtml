@model HomeViewModel
@{
    var heroImage = Model.HeroImage ?? Model.FeaturedProducts.FirstOrDefault(p => p.Image is not null)?.Image;
    var processSteps = Enumerable.Range(1, 5);
    var reasons = Enumerable.Range(1, 6);
}
@section Head {
    @if (heroImage is not null)
    {
        <link rel="preload" as="image" href="@ViewHelpers.SmallImage(heroImage)" imagesrcset="@ViewHelpers.SrcSet(heroImage)" imagesizes="100vw" fetchpriority="high" />
    }
}

<section class="hero">
    @if (heroImage is not null)
    {
        <div class="hero-media">
            @if (Model.HeroVideo is not null)
            {
                <video autoplay muted loop playsinline poster="@ViewHelpers.SmallImage(heroImage)" aria-hidden="true"><source src="@Model.HeroVideo" type="video/mp4" media="(min-width: 900px)" /></video>
            }
            else
            {
                <img src="@ViewHelpers.SmallImage(heroImage)" srcset="@ViewHelpers.SrcSet(heroImage)" sizes="100vw" alt="" fetchpriority="high" width="1600" height="900" />
            }
        </div>
    }
    <div class="container hero-inner reveal">
        <p class="eyebrow">@L["Home.HeroEyebrow"]</p>
        <h1>@L["Home.HeroTitle"] <span>@L["Home.HeroTitleAccent"]</span></h1>
        <p class="lead">@L["Home.HeroSubtitle"]</p>
        <div class="button-row">
            <a href="@Url.Localized(SiteRoutes.Quote)" class="btn btn-primary btn-lg">@L["Common.RequestQuote"]</a>
            <a href="@Url.Localized(SiteRoutes.Products)" class="btn btn-ghost-light btn-lg">@L["Home.ExploreProducts"]</a>
        </div>
        <ul class="hero-badges">
            <li>@ViewHelpers.Icon("factory") @L["Home.BadgeInHouse"]</li>
            <li>@ViewHelpers.Icon("wrench") @L["Home.BadgeExport"]</li>
        </ul>
    </div>
</section>

@if (Model.Categories.Count > 0)
{
    <section class="section">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="eyebrow">@L["Nav.Products"]</p>
                    <h2>@L["Home.CategoriesTitle"]</h2>
                    <p>@L["Home.CategoriesLead"]</p>
                </div>
                <a href="@Url.Localized(SiteRoutes.Products)" class="link-arrow">@L["Products.AllProducts"] @ViewHelpers.Icon("arrow-right")</a>
            </div>
            <div class="grid grid-4">
                @foreach (var category in Model.Categories)
                {
                    <partial name="_CategoryCard" model="category" />
                }
            </div>
        </div>
    </section>
}

<section class="section section-dark">
    <div class="container">
        <div class="section-head">
            <div>
                <p class="eyebrow">@L["Home.ProcessEyebrow"]</p>
                <h2>@L["Home.ProcessTitle"]</h2>
                <p>@L["Home.ProcessLead"]</p>
            </div>
            <a href="@Url.Localized(SiteRoutes.Services)" class="btn btn-ghost-light">@L["Home.AllServices"]</a>
        </div>
        <ol class="process">
            @foreach (var step in processSteps)
            {
                <li>
                    <h3>@L[$"Home.Process{step}Title"]</h3>
                    <p>@L[$"Home.Process{step}Text"]</p>
                </li>
            }
        </ol>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head">
            <div>
                <p class="eyebrow">@L["Home.WhyEyebrow"]</p>
                <h2>@L["Home.WhyTitle"]</h2>
                <p>@L["Home.AboutLead"]</p>
            </div>
            <a href="@Url.Localized(SiteRoutes.About)" class="link-arrow">@L["Home.LearnMore"] @ViewHelpers.Icon("arrow-right")</a>
        </div>
        <div class="grid grid-3">
            @foreach (var reason in reasons)
            {
                <div class="feature">
                    <h3>@L[$"Home.Why{reason}Title"]</h3>
                    <p>@L[$"Home.Why{reason}Text"]</p>
                </div>
            }
        </div>
    </div>
</section>

@if (Model.FeaturedProducts.Count > 0)
{
    <section class="section section-alt">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="eyebrow">@L["Home.FeaturedEyebrow"]</p>
                    <h2>@L["Home.FeaturedTitle"]</h2>
                    <p>@L["Home.FeaturedLead"]</p>
                </div>
                <a href="@Url.Localized(SiteRoutes.Products)" class="link-arrow">@L["Products.AllProducts"] @ViewHelpers.Icon("arrow-right")</a>
            </div>
            <div class="grid grid-4">
                @foreach (var product in Model.FeaturedProducts)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </div>
    </section>
}

@if (Model.Videos.Count > 0)
{
    <section class="section">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="eyebrow">@L["Nav.Videos"]</p>
                    <h2>@L["Home.VideoTitle"]</h2>
                </div>
                <a href="@Url.Localized(SiteRoutes.Videos)" class="link-arrow">@L["Home.AllVideos"] @ViewHelpers.Icon("arrow-right")</a>
            </div>
            <div class="grid grid-3">
                @foreach (var video in Model.Videos)
                {
                    <partial name="_Video" model="video" />
                }
            </div>
        </div>
    </section>
}

@if (Model.References.Count > 0)
{
    <section class="section section-alt">
        <div class="container">
            <div class="section-head">
                <div>
                    <p class="eyebrow">@L["Home.ReferencesEyebrow"]</p>
                    <h2>@L["Home.ReferencesTitle"]</h2>
                    <p>@L["Home.ReferencesLead"]</p>
                </div>
                <a href="@Url.Localized(SiteRoutes.Certificates)" class="link-arrow">@L["Nav.Certificates"] @ViewHelpers.Icon("arrow-right")</a>
            </div>
            <div class="reference-strip">
                @foreach (var reference in Model.References)
                {
                    if (reference.WebsiteUrl is not null)
                    {
                        <a href="@reference.WebsiteUrl" target="_blank" rel="noopener nofollow"><img src="@reference.Logo" alt="@reference.Name" loading="lazy" decoding="async" width="160" height="56" /></a>
                    }
                    else
                    {
                        <span><img src="@reference.Logo" alt="@reference.Name" loading="lazy" decoding="async" width="160" height="56" /></span>
                    }
                }
            </div>
        </div>
    </section>
}

<partial name="_CtaSection" />
