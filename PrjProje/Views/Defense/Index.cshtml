@model DefenseViewModel
@{
    var header = new PageHeaderModel(L["Defense.Title"], L["Defense.Lead"], L["Nav.Defense"]);
}
@section Head {
    <link rel="stylesheet" href="~/css/defense-3d.css" asp-append-version="true" />
}
<partial name="_PageHeader" model="header" />

@* Desktop: the section pins under the menu while the scroll drives a 3D rocket on the right (defense-3d.js): it comes
   apart, reassembles, ignites and flies off, then the page carries on. Each data-dive-beat is one chapter of the copy,
   swapped in step with the rocket; the last one fills the screen once the rocket has gone.
   Phones, tablets and reduced motion get the chapters one under another on the dark band. *@
<section class="dive" data-dive>
    <div class="dive-pin">
        <div class="dive-stage" data-dive-stage>
            <canvas role="img" aria-label="@L["Defense.ModelAlt"]"></canvas>
            <span class="dive-flash" data-dive-flash aria-hidden="true"></span>
            <ul class="stage-labels" data-stage-labels aria-hidden="true">
                <li class="stage-label"><span></span><span>@L["Defense.ModelPartNose"]</span></li>
                <li class="stage-label"><span></span><span>@L["Defense.ModelPartBody"]</span></li>
                <li class="stage-label"><span></span><span>@L["Defense.ModelPartLiner"]</span></li>
                <li class="stage-label"><span></span><span>@L["Defense.ModelPartAft"]</span></li>
            </ul>
        </div>
        <div class="container dive-copy">
            <div class="dive-beat is-active" data-dive-beat>
                <span class="eyebrow">@L["Defense.IntroEyebrow"]</span>
                <h2 class="section-title">@L["Defense.IntroTitle"]</h2>
                <p class="lead-text">@L["Defense.IntroLead"]</p>
            </div>
            <div class="dive-beat" data-dive-beat>
                <span class="eyebrow">@L["Defense.LinerEyebrow"]</span>
                <h3 class="section-title">@L["Defense.LinerTitle"]</h3>
                <p>@L["Defense.IntroText"]</p>
            </div>
            <div class="dive-beat" data-dive-beat>
                <h3 class="section-title">@L["Defense.ReadyTitle"]</h3>
                <p class="dive-clearance">
                    <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                    <span><strong>@L["Common.SecurityClearance"]</strong>@L["Defense.ClearanceText"]</span>
                </p>
            </div>
            <div class="dive-beat dive-finale" data-dive-beat>
                <span class="eyebrow">@L["Defense.FinaleEyebrow"]</span>
                <ul class="dive-words">
                    <li>@L["Defense.PointDomestic"]</li>
                    <li>@L["Defense.PointConfidentiality"]</li>
                    <li>@L["Defense.PointQuality"]</li>
                    <li>@L["Defense.PointTraceability"]</li>
                </ul>
            </div>
        </div>
        <div class="dive-hud" data-dive-hud data-phases="@L["Defense.HudPhases"]" aria-hidden="true">
            <span class="hud-phase"><i></i><span data-hud-phase></span></span>
            <span class="hud-telemetry">@L["Defense.HudAltitude"] <b data-hud-alt>0000</b> <small>m</small> <span>/</span> @L["Defense.HudSpeed"] <b data-hud-vel>000</b> <small>m/s</small></span>
        </div>
        <ol class="dive-rail" aria-hidden="true"><li class="is-active"></li><li></li><li></li><li></li></ol>
        <div class="dive-hint" aria-hidden="true"><span></span>@L["Defense.ScrollHint"]</div>
    </div>
</section>

<section class="section section-light">
    <div class="container">
        <div class="row g-4">
            <div class="col-sm-6 col-lg-3"><div class="principle-card h-100"><i class="fa-solid fa-flag" aria-hidden="true"></i><h3>@L["Defense.PointDomestic"]</h3><p>@L["Defense.PrincipleDomestic"]</p></div></div>
            <div class="col-sm-6 col-lg-3"><div class="principle-card h-100"><i class="fa-solid fa-user-lock" aria-hidden="true"></i><h3>@L["Defense.PointConfidentiality"]</h3><p>@L["Defense.PrincipleConfidentiality"]</p></div></div>
            <div class="col-sm-6 col-lg-3"><div class="principle-card h-100"><i class="fa-solid fa-clipboard-check" aria-hidden="true"></i><h3>@L["Defense.PointQuality"]</h3><p>@L["Defense.PrincipleQuality"]</p></div></div>
            <div class="col-sm-6 col-lg-3"><div class="principle-card h-100"><i class="fa-solid fa-link" aria-hidden="true"></i><h3>@L["Defense.PointTraceability"]</h3><p>@L["Defense.PrincipleTraceability"]</p></div></div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-heading">
            <div>
                <span class="eyebrow">@L["Nav.Products"]</span>
                <h2 class="section-title">@L["Defense.ProductsTitle"]</h2>
            </div>
        </div>
        @if (Model.Products.Count > 0)
        {
            <div class="row g-4">
                @foreach (var product in Model.Products)
                {
                    <div class="col-md-6 col-lg-4">
                        <partial name="_ProductCard" model="product" />
                    </div>
                }
            </div>
        }
        <div class="notice notice-dark mt-4">
            <i class="fa-solid fa-user-lock" aria-hidden="true"></i>
            <span>@L["Defense.ConfidentialityNotice"]</span>
        </div>
    </div>
</section>

<partial name="_CtaSection" />

@section Scripts {
    <script type="module" src="~/js/defense-3d.js" asp-append-version="true"></script>
}
