@model IReadOnlyList<DocumentDto>
@{
    var header = new PageHeaderModel(L["Manuals.Title"], L["Manuals.Lead"], L["Nav.Products"]);
}
<partial name="_PageHeader" model="header" />

<section class="section">
    <div class="container">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                @ViewHelpers.Icon("book-open")
                <h2>@L["Manuals.EmptyTitle"]</h2>
                <p>@L["Manuals.EmptyText"]</p>
            </div>
        }
        else
        {
            <div class="grid grid-4">
                @foreach (var catalog in Model)
                {
                    <article class="card">
                        <button type="button" class="doc-cover" data-catalog="@catalog.FilePath" data-title="@catalog.Title" aria-label="@L["Manuals.Read"]: @catalog.Title">
                            @if (catalog.CoverImagePath is not null)
                            {
                                <img src="@catalog.CoverImagePath" alt="" width="420" height="594" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                @ViewHelpers.Icon("book-open")
                            }
                        </button>
                        <div class="card-body">
                            <h2 class="card-title">@catalog.Title</h2>
                            @if (!string.IsNullOrEmpty(catalog.Description))
                            {
                                <p class="card-text">@catalog.Description</p>
                            }
                            <div class="card-meta">
                                <span>PDF · @ViewHelpers.FileSize(catalog.FileSize)</span>
                                <a href="@catalog.FilePath" download class="link-arrow">@ViewHelpers.Icon("download") @L["Manuals.Download"]</a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

@if (Model.Count > 0)
{
    <dialog class="catalog-viewer" id="catalogViewer" aria-labelledby="catalogViewerTitle" data-loading="@L["Manuals.Loading"]" data-error="@L["Manuals.Error"]">
        <div class="catalog-viewer-bar">
            <h2 id="catalogViewerTitle"></h2>
            <span class="catalog-viewer-page" aria-live="polite"></span>
            <a class="catalog-viewer-btn" data-catalog-download download aria-label="@L["Manuals.Download"]">@ViewHelpers.Icon("download")</a>
            <button type="button" class="catalog-viewer-btn" data-catalog-close aria-label="@L["Manuals.Close"]">@ViewHelpers.Icon("x")</button>
        </div>
        <div class="catalog-viewer-stage">
            <p class="catalog-viewer-status" role="status"></p>
            <button type="button" class="catalog-viewer-btn catalog-viewer-nav catalog-viewer-prev" data-catalog-prev aria-label="@L["Manuals.Previous"]">@ViewHelpers.Icon("chevron-right")</button>
            <button type="button" class="catalog-viewer-btn catalog-viewer-nav catalog-viewer-next" data-catalog-next aria-label="@L["Manuals.Next"]">@ViewHelpers.Icon("chevron-right")</button>
        </div>
    </dialog>
}

<partial name="_CtaSection" />

@section Scripts {
    <script src="~/js/catalog.js" asp-append-version="true" defer></script>
}
