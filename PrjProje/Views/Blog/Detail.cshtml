@model BlogPostDetailDto
@{
    var seo = ViewData[PageSeo.ViewDataKey] as PageSeo;
    var blogPath = Url.Localized(SiteRoutes.Blog);
    var shareUrl = Uri.EscapeDataString(Url.Absolute(seo!.CanonicalPath));
}
<article class="section">
    @* No page header strip: the post opens with its own title, meta and cover in the reading column. *@
    <div class="container prose" style="margin: 0 auto">
        <h1>@Model.Title</h1>
        <p class="post-meta">
            @if (Model.CategoryName is not null)
            {
                <a href="@blogPath?category=@Uri.EscapeDataString(Model.CategorySlug!)">@Model.CategoryName</a>
            }
            <time datetime="@Model.PublishedDate.ToString("yyyy-MM-dd")">@Model.PublishedDate.ToLocalTime().ToString("d MMMM yyyy")</time>
            <span>@Model.AuthorName</span>
        </p>
        @if (Model.CoverImage is not null)
        {
            <div class="post-cover">
                <img src="@Model.CoverImage" srcset="@ViewHelpers.SrcSet(Model.CoverImage)" sizes="(min-width: 960px) 72ch, 100vw" alt="" width="960" height="640" fetchpriority="high" />
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.Summary))
        {
            <p class="lead">@Model.Summary</p>
        }
        @Html.Raw(Model.Content)

        @if (Model.Tags.Count > 0)
        {
            <ul class="tag-list" aria-label="@L["Blog.Tags"]">
                @foreach (var tag in Model.Tags)
                {
                    <li><a href="@blogPath?tag=@Uri.EscapeDataString(tag.Slug)" rel="tag">#@tag.Name</a></li>
                }
            </ul>
        }

        <p class="post-meta" style="margin-top: var(--space-6)">
            <strong>@L["Blog.Share"]:</strong>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url=@shareUrl" target="_blank" rel="noopener">LinkedIn</a>
            <a href="https://www.facebook.com/sharer/sharer.php?u=@shareUrl" target="_blank" rel="noopener">Facebook</a>
            <a href="mailto:?subject=@Uri.EscapeDataString(Model.Title)&amp;body=@shareUrl">E-mail</a>
        </p>
    </div>
</article>

@if (Model.RelatedPosts.Count > 0)
{
    <section class="section section-alt">
        <div class="container">
            <h2>@L["Blog.Related"]</h2>
            <div class="grid grid-3">
                @foreach (var post in Model.RelatedPosts)
                {
                    <partial name="_BlogCard" model="post" />
                }
            </div>
        </div>
    </section>
}

<partial name="_CtaSection" />
