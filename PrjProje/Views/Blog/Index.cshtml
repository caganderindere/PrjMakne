@model BlogListViewModel
@{
    var header = new PageHeaderModel(L["Blog.Title"], L["Blog.Lead"], L["Nav.Blog"]);
    var basePath = Url.Localized(SiteRoutes.Blog);
    var pagination = new PaginationModel(Model.Posts.Page, Model.Posts.TotalPages, basePath, new Dictionary<string, string?>
    {
        ["category"] = Model.CurrentCategorySlug,
        ["tag"] = Model.CurrentTag?.Slug,
        ["q"] = Model.Search
    });
}
<partial name="_PageHeader" model="header" />

<section class="section">
    <div class="container split split-aside">
        <aside class="filter-nav" aria-label="@L["Blog.Categories"]">
            <form method="get" action="@basePath" class="search-box" role="search">
                <label for="blogSearch" class="visually-hidden">@L["Blog.SearchLabel"]</label>
                @ViewHelpers.Icon("search")
                <input type="search" id="blogSearch" name="q" value="@Model.Search" placeholder="@L["Blog.SearchPlaceholder"]" maxlength="100" />
                <button type="submit" class="btn btn-primary">@L["Common.Search"]</button>
            </form>
            <h2>@L["Blog.Categories"]</h2>
            <ul class="filter-list">
                <li><a href="@basePath" aria-current="@(Model.CurrentCategorySlug is null ? "page" : null)"><span>@L["Blog.AllPosts"]</span></a></li>
                @foreach (var category in Model.Categories)
                {
                    <li>
                        <a href="@basePath?category=@Uri.EscapeDataString(category.Slug)" aria-current="@(category.Slug == Model.CurrentCategorySlug ? "page" : null)">
                            <span>@category.Name</span><span class="count">@category.PostCount</span>
                        </a>
                    </li>
                }
            </ul>
        </aside>
        <div>
            @if (Model.CurrentTag is not null)
            {
                <p class="result-line">@L["Blog.TagFilter", Model.CurrentTag.Name] <a href="@basePath">@L["Common.ClearFilter"]</a></p>
            }
            @if (Model.Posts.Items.Count == 0)
            {
                <div class="empty-state">
                    @ViewHelpers.Icon("file-text")
                    <h2>@L["Blog.EmptyTitle"]</h2>
                    <p>@L["Blog.EmptyText"]</p>
                </div>
            }
            else
            {
                <div class="grid grid-2">
                    @foreach (var post in Model.Posts.Items)
                    {
                        <partial name="_BlogCard" model="post" />
                    }
                </div>
                <partial name="_Pagination" model="pagination" />
            }
        </div>
    </div>
</section>
