@model CareersViewModel
@{
    var header = new PageHeaderModel(L["Careers.Title"], L["Careers.Lead"], L["Nav.Careers"]);
    var reasons = new[]
    {
        (Icon: "fa-solid fa-helmet-safety", Index: 1),
        (Icon: "fa-solid fa-graduation-cap", Index: 2),
        (Icon: "fa-solid fa-shield-halved", Index: 3),
        (Icon: "fa-solid fa-chart-line", Index: 4)
    };
}
<partial name="_PageHeader" model="header" />

<section class="section section-dark careers-intro">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6">
                <span class="eyebrow eyebrow-light">@L["Nav.Careers"]</span>
                <h2 class="section-title">@L["Careers.Title"]</h2>
                <p class="lead mb-4">@L["Careers.Lead"]</p>
                <p>@L["Careers.Intro"]</p>
                <a href="#basvuru" class="btn btn-brand btn-lg mt-2"><i class="fa-solid fa-file-signature me-2" aria-hidden="true"></i>@L["Careers.Apply"]</a>
            </div>
            <div class="col-lg-6">
                @* Brand plate: the light logo on the studio grid used by the home hero, framed by the red corner marks. *@
                <div class="careers-brand" aria-hidden="true">
                    <img src="~/images/logo-light.png" alt="" width="350" height="84" loading="lazy" decoding="async" />
                    <span class="careers-brand-line">@L["Careers.BrandLine"]</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section section-light">
    <div class="container">
        <div class="section-heading">
            <div>
                <span class="eyebrow">@L["Careers.WhyEyebrow"]</span>
                <h2 class="section-title">@L["Careers.WhyTitle"]</h2>
            </div>
        </div>
        <div class="row g-4">
            @foreach (var reason in reasons)
            {
                <div class="col-sm-6 col-lg-3">
                    <div class="why-card h-100">
                        <span class="why-number">@reason.Index.ToString("00")</span>
                        <i class="@reason.Icon why-icon" aria-hidden="true"></i>
                        <h3>@L[$"Careers.Why{reason.Index}Title"]</h3>
                        <p>@L[$"Careers.Why{reason.Index}Text"]</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="section" id="basvuru">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-4">
                <span class="eyebrow">@L["Careers.ProcessEyebrow"]</span>
                <h2 class="content-title">@L["Careers.ProcessTitle"]</h2>
                <ol class="steps-list">
                    <li>@L["Careers.Step1"]</li>
                    <li>@L["Careers.Step2"]</li>
                    <li>@L["Careers.Step3"]</li>
                    <li>@L["Careers.Step4"]</li>
                </ol>
                <p class="small text-muted mt-4 mb-0"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>@L["Careers.PrivacyNote"]</p>
            </div>
            <div class="col-lg-8">
                <div class="form-card">
                    <h2 class="content-title">@L["Careers.FormTitle"]</h2>
                    @if (TempData["FormSuccess"] is string success)
                    {
                        <div class="alert alert-success d-flex gap-2" role="status"><i class="fa-solid fa-circle-check mt-1" aria-hidden="true"></i><span>@success</span></div>
                    }
                    <form method="post" action="@Url.Localized(SiteRoutes.Careers)#basvuru" enctype="multipart/form-data" asp-antiforgery="true" novalidate>
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                        <partial name="_SpamProtection" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Form.FullName" class="form-label required"></label>
                                <input asp-for="Form.FullName" class="form-control" autocomplete="name" required />
                                <span asp-validation-for="Form.FullName" class="invalid-text"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Form.Position" class="form-label required"></label>
                                <select asp-for="Form.Position" class="form-select" required>
                                    <option value="">@L["Careers.PositionPick"]</option>
                                    @foreach (var key in CareerAreas.Turkish.Keys)
                                    {
                                        <option value="@key">@L[$"Careers.Area.{key}"]</option>
                                    }
                                </select>
                                <span asp-validation-for="Form.Position" class="invalid-text"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Form.Email" class="form-label required"></label>
                                <input asp-for="Form.Email" type="email" class="form-control" autocomplete="email" required />
                                <span asp-validation-for="Form.Email" class="invalid-text"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Form.Phone" class="form-label required"></label>
                                <input asp-for="Form.Phone" type="tel" class="form-control" autocomplete="tel" required />
                                <span asp-validation-for="Form.Phone" class="invalid-text"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Form.City" class="form-label"></label>
                                <input asp-for="Form.City" class="form-control" autocomplete="address-level2" />
                                <span asp-validation-for="Form.City" class="invalid-text"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Form.Resume" class="form-label required"></label>
                                <input asp-for="Form.Resume" type="file" class="form-control" accept="@Model.AllowedExtensions" required />
                                <div class="form-text">@L["Careers.ResumeHelp"]</div>
                                <span asp-validation-for="Form.Resume" class="invalid-text"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Form.Message" class="form-label"></label>
                                <textarea asp-for="Form.Message" class="form-control" rows="4" placeholder="@L["Careers.CoverLetterHint"]"></textarea>
                                <span asp-validation-for="Form.Message" class="invalid-text"></span>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input asp-for="Form.PrivacyConsent" class="form-check-input" required />
                                    <label asp-for="Form.PrivacyConsent" class="form-check-label">
                                        @L["Form.PrivacyConsentText"] <a href="@Url.Localized(SiteRoutes.Privacy)" target="_blank">@L["Legal.PrivacyTitle"]</a>
                                    </label>
                                </div>
                                <span asp-validation-for="Form.PrivacyConsent" class="invalid-text"></span>
                            </div>
                            <div class="col-12">
                                <partial name="_Turnstile" model="PrjProje.Application.Interfaces.TurnstileForm.Contact" />
                                <button type="submit" class="btn btn-brand btn-lg"><i class="fa-solid fa-paper-plane me-2" aria-hidden="true"></i>@L["Careers.Submit"]</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
