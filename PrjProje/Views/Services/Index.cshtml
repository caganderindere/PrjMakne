@model ServicesViewModel
@{
    var header = new PageHeaderModel(L["Services.Title"], L["Services.Lead"], L["Nav.Services"]);
    var steps = Enumerable.Range(1, 5);
}
<partial name="_PageHeader" model="header" />

<section class="section">
    <div class="container">
        <div class="section-head">
            <div>
                <p class="eyebrow">@L["Services.IntroEyebrow"]</p>
                <h2>@L["Services.IntroTitle"]</h2>
                <p>@L["Services.IntroText"]</p>
            </div>
        </div>
        <div class="grid grid-2">
            @foreach (var service in Model.Services)
            {
                <article class="card">
                    @if (service.Image is not null)
                    {
                        <div class="card-media"><img src="@ViewHelpers.SmallImage(service.Image)" srcset="@ViewHelpers.SrcSet(service.Image)" sizes="(max-width: 640px) 100vw, 50vw" alt="" loading="lazy" decoding="async" width="640" height="480" /></div>
                    }
                    <div class="card-body" style="position: relative">
                        <h3 class="card-title"><a href="@Url.Localized(SiteRoutes.ServiceDetail, service.Slug)">@service.Title</a></h3>
                        <p class="card-text">@service.Summary</p>
                        <div class="card-meta"><span class="link-arrow">@L["Common.ViewDetails"] @ViewHelpers.Icon("arrow-right")</span></div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section-dark">
    <div class="container">
        <div class="section-head">
            <div>
                <p class="eyebrow">@L["Home.ProcessEyebrow"]</p>
                <h2>@L["Home.ProcessTitle"]</h2>
            </div>
        </div>
        <ol class="process">
            @foreach (var step in steps)
            {
                <li>
                    <h3>@L[$"Home.Process{step}Title"]</h3>
                    <p>@L[$"Home.Process{step}Text"]</p>
                </li>
            }
        </ol>
    </div>
</section>

<partial name="_CtaSection" />
