@model ServicesViewModel
@{
    var header = new PageHeaderModel(L["Services.Title"], L["Services.Lead"], L["Nav.Services"]);
}
<partial name="_PageHeader" model="header" />

<section class="section">
    <div class="container">
        <div class="section-head">
            <div>
                <p class="eyebrow">@L["Services.IntroEyebrow"]</p>
                <h2>@L["Services.IntroTitle"]</h2>
                <p>@L["Services.IntroText"]</p>
            </div>
        </div>
        <div class="service-grid">
            @foreach (var service in Model.Services)
            {
                <article class="service-card">
                    @if (service.Image is not null)
                    {
                        <img src="@ViewHelpers.SmallImage(service.Image)" srcset="@ViewHelpers.SrcSet(service.Image)" sizes="(max-width: 768px) 100vw, 50vw" alt="" loading="lazy" decoding="async" width="960" height="720" />
                    }
                    <h3><a href="@Url.Localized(SiteRoutes.ServiceDetail, service.Slug)">@service.Title</a></h3>
                    <p>@service.Summary</p>
                    <span class="link-arrow" aria-hidden="true">@L["Common.ViewDetails"] @ViewHelpers.Icon("arrow-right")</span>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section-dark">
    <div class="container">
        <div class="section-head">
            <div>
                <p class="eyebrow">@L["Home.ProcessEyebrow"]</p>
                <h2>@L["Home.ProcessTitle"]</h2>
            </div>
        </div>
        <partial name="_ProcessTimeline" />
    </div>
</section>

<partial name="_CtaSection" />
