@{
    var header = new PageHeaderModel(L["About.Title"], L["About.Lead"], L["Nav.About"]);
    var steps = Enumerable.Range(1, 5);
    var capabilities = new[] { "Cnc", "Press", "Rubber", "Laser", "Paint", "Coating", "Casting", "Quality" };
}
<partial name="_PageHeader" model="header" />

<section class="section">
    <div class="container split">
        <div>
            <p class="eyebrow">@L["About.WhoEyebrow"]</p>
            <h2>@L["About.WhoTitle"]</h2>
            <p class="lead">@L["About.WhoLead"]</p>
        </div>
        <div class="prose">
            <p>@L["About.WhoText1"]</p>
            <p>@L["About.WhoText2"]</p>
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container grid grid-2">
        <div class="statement">
            <h3>@ViewHelpers.Icon("globe") @L["About.VisionTitle"]</h3>
            <p>@L["About.VisionText"]</p>
        </div>
        <div class="statement">
            <h3>@ViewHelpers.Icon("shield-check") @L["About.MissionTitle"]</h3>
            <p>@L["About.MissionText"]</p>
        </div>
    </div>
</section>

<section class="section section-dark">
    <div class="container">
        <div class="section-head">
            <div>
                <p class="eyebrow">@L["About.HistoryEyebrow"]</p>
                <h2>@L["About.HistoryTitle"]</h2>
            </div>
        </div>
        <ol class="process">
            @foreach (var step in steps)
            {
                <li>
                    <h3>@L[$"About.History{step}Title"]</h3>
                    <p>@L[$"About.History{step}Text"]</p>
                </li>
            }
        </ol>
    </div>
</section>

<section class="section">
    <div class="container split">
        <div>
            <p class="eyebrow">@L["About.FacilityEyebrow"]</p>
            <h2>@L["About.FacilityTitle"]</h2>
            <p>@L["About.FacilityText"]</p>
        </div>
        <ul class="chips chips-strong">
            @foreach (var capability in capabilities)
            {
                <li>@L[$"About.Facility{capability}"]</li>
            }
        </ul>
    </div>
</section>

<section class="section section-alt">
    <div class="container grid grid-3">
        <div class="feature">
            <h3>@L["About.HrTitle"]</h3>
            <p>@L["About.HrText"]</p>
        </div>
        <div class="feature">
            <h3>@L["About.DomesticTitle"]</h3>
            <p>@L["About.DomesticText"]</p>
        </div>
        <div class="feature">
            <h3>@L["About.ExportTitle"]</h3>
            <p>@L["About.ExportText"]</p>
        </div>
    </div>
</section>

<partial name="_CtaSection" />
