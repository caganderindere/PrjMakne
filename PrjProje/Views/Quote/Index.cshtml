@model QuoteViewModel
@{
    var header = new PageHeaderModel(L["Quote.Title"], L["Quote.Lead"]);
}
<partial name="_PageHeader" model="header" />

<section class="section">
    <div class="container form-layout">
        <div class="form-card">
            @if (TempData["FormSuccess"] is string success)
            {
                <div class="alert alert-success" role="status">@ViewHelpers.Icon("circle-check")<span>@success</span></div>
            }
            <form method="post" action="@Url.Localized(SiteRoutes.Quote)" enctype="multipart/form-data" asp-antiforgery="true" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <partial name="_SpamProtection" />
                <input type="hidden" asp-for="Form.ProductId" />

                <h2 class="form-section-title">@L["Quote.ContactSection"]</h2>
                <div class="form-grid">
                    <div class="field">
                        <label asp-for="Form.FullName" class="required"></label>
                        <input asp-for="Form.FullName" autocomplete="name" required />
                        <span asp-validation-for="Form.FullName" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Form.CompanyName" class="required"></label>
                        <input asp-for="Form.CompanyName" autocomplete="organization" required />
                        <span asp-validation-for="Form.CompanyName" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Form.Email" class="required"></label>
                        <input asp-for="Form.Email" type="email" autocomplete="email" required />
                        <span asp-validation-for="Form.Email" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Form.Phone" class="required"></label>
                        <input asp-for="Form.Phone" type="tel" autocomplete="tel" required />
                        <span asp-validation-for="Form.Phone" class="field-error"></span>
                    </div>
                </div>

                <h2 class="form-section-title">@L["Quote.ProductSection"]</h2>
                <div class="form-grid">
                    <div class="field">
                        <label asp-for="Form.ProductName"></label>
                        <input asp-for="Form.ProductName" list="productOptions" placeholder="@L["Quote.ProductPlaceholder"]" data-product-input />
                        <datalist id="productOptions">
                            @foreach (var product in Model.Products)
                            {
                                <option value="@product.Name" data-id="@product.Id"></option>
                            }
                        </datalist>
                        <span asp-validation-for="Form.ProductName" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Form.Quantity"></label>
                        <input asp-for="Form.Quantity" placeholder="@L["Quote.QuantityPlaceholder"]" />
                        <span asp-validation-for="Form.Quantity" class="field-error"></span>
                    </div>
                    <div class="field field-full">
                        <label asp-for="Form.Description" class="required"></label>
                        <textarea asp-for="Form.Description" rows="6" required></textarea>
                        <span asp-validation-for="Form.Description" class="field-error"></span>
                    </div>
                    <div class="field field-full">
                        <label asp-for="Form.Attachment"></label>
                        <input asp-for="Form.Attachment" type="file" accept="@Model.AllowedExtensions" aria-describedby="attachmentHelp" />
                        <p class="field-help" id="attachmentHelp">@L["Quote.AttachmentHelp"]</p>
                        <span asp-validation-for="Form.Attachment" class="field-error"></span>
                    </div>
                    <div class="field field-full">
                        <div class="check">
                            <input asp-for="Form.PrivacyConsent" required />
                            <label asp-for="Form.PrivacyConsent">@L["Form.PrivacyConsentText"] <a href="@Url.Localized(SiteRoutes.Privacy)" target="_blank">@L["Legal.PrivacyTitle"]</a></label>
                        </div>
                        <span asp-validation-for="Form.PrivacyConsent" class="field-error"></span>
                    </div>
                    <div class="field-full">
                        <button type="submit" class="btn btn-primary btn-lg">@ViewHelpers.Icon("send")@L["Quote.Submit"]</button>
                    </div>
                </div>
            </form>
        </div>
        <aside>
            <div class="side-card side-card-dark">
                <h2>@L["Quote.ProcessTitle"]</h2>
                <ol class="steps">
                    <li>@L["Quote.Step1"]</li>
                    <li>@L["Quote.Step2"]</li>
                    <li>@L["Quote.Step3"]</li>
                    <li>@L["Quote.Step4"]</li>
                </ol>
            </div>
            <div class="side-card">
                <h2>@L["Quote.ConfidentialTitle"]</h2>
                <p>@L["Quote.ConfidentialText"]</p>
            </div>
        </aside>
    </div>
</section>
