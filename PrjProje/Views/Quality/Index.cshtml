@using PrjProje.Domain.Enums
@model QualityViewModel
@{
    var header = new PageHeaderModel(L["Quality.Title"], L["Quality.Lead"], L["Nav.Quality"]);
    var groups = Model.Documents.GroupBy(d => d.DocumentType).OrderBy(g => g.Key);
}
<partial name="_PageHeader" model="header" />

<section class="section">
    <div class="container">
        <div class="row g-5 align-items-center mb-5">
            <div class="col-lg-6">
                <span class="eyebrow">@L["Quality.PolicyEyebrow"]</span>
                <h2 class="section-title">@L["Quality.PolicyTitle"]</h2>
                <p>@L["Quality.PolicyText"]</p>
            </div>
            <div class="col-lg-6">
                <ul class="check-list check-list-boxed">
                    <li>@L["Quality.Point1"]</li>
                    <li>@L["Quality.Point2"]</li>
                    <li>@L["Quality.Point3"]</li>
                    <li>@L["Quality.Point4"]</li>
                </ul>
            </div>
        </div>

        @if (!Model.Documents.Any())
        {
            <div class="empty-state">
                <i class="fa-solid fa-file-shield" aria-hidden="true"></i>
                <h2>@L["Quality.EmptyTitle"]</h2>
                <p>@L["Quality.EmptyText"]</p>
            </div>
        }
        @foreach (var group in groups)
        {
            <h2 class="content-title mt-5">@L[$"DocumentType.{group.Key}"]</h2>
            <div class="row g-4">
                @foreach (var document in group)
                {
                    <div class="col-md-6 col-lg-4">
                        <a href="@document.FilePath" class="document-card h-100" target="_blank" rel="noopener">
                            <span class="document-icon"><i class="fa-solid fa-file-pdf" aria-hidden="true"></i></span>
                            <span class="document-body">
                                <span class="document-title">@document.Title</span>
                                @if (!string.IsNullOrEmpty(document.Description))
                                {
                                    <span class="document-text">@document.Description</span>
                                }
                                <span class="document-meta">@document.DocumentDate.ToString("d MMMM yyyy") &middot; PDF &middot; @ViewHelpers.FileSize(document.FileSize)</span>
                            </span>
                            <i class="fa-solid fa-download document-download" aria-hidden="true"></i>
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</section>

<partial name="_CtaSection" />
