@using PrjProje.Domain.Enums
@model CertificatesViewModel
@{
    var header = new PageHeaderModel(L["Certificates.Title"], L["Certificates.Lead"], L["Nav.Certificates"]);
    var groups = Model.Documents.GroupBy(d => d.DocumentType).OrderBy(g => g.Key);
    var points = Enumerable.Range(1, 4);
}
<partial name="_PageHeader" model="header" />

<section class="section">
    <div class="container">
        <div class="split" style="margin-bottom: var(--space-7)">
            <div>
                <p class="eyebrow">@L["Certificates.PolicyEyebrow"]</p>
                <h2>@L["Certificates.PolicyTitle"]</h2>
                <p>@L["Certificates.PolicyText"]</p>
            </div>
            <ul class="check-list">
                @foreach (var point in points)
                {
                    <li>@ViewHelpers.Icon("check") @L[$"Certificates.Point{point}"]</li>
                }
            </ul>
        </div>

        @if (!Model.Documents.Any())
        {
            <div class="empty-state">
                @ViewHelpers.Icon("award")
                <h2>@L["Certificates.EmptyTitle"]</h2>
                <p>@L["Certificates.EmptyText"]</p>
            </div>
        }
        @foreach (var group in groups)
        {
            <h2>@L[$"DocumentType.{group.Key}"]</h2>
            <div class="grid grid-3" style="margin-bottom: var(--space-7)">
                @foreach (var document in group)
                {
                    <article class="card doc-card">
                        @ViewHelpers.Icon("file-text")
                        <div>
                            <h3 class="card-title"><a href="@document.FilePath" target="_blank" rel="noopener">@document.Title</a></h3>
                            @if (!string.IsNullOrEmpty(document.Description))
                            {
                                <p class="card-text">@document.Description</p>
                            }
                            <p class="card-text">@document.DocumentDate.ToString("d MMMM yyyy") · PDF · @ViewHelpers.FileSize(document.FileSize)</p>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

<partial name="_CtaSection" />
