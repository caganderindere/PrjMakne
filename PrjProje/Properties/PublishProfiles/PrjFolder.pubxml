<?xml version="1.0" encoding="utf-8"?>
<!-- Folder publish for IIS. Holds no secrets: connection string and admin account come from the server (see docs/deploy.md). -->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <ExcludeApp_Data>true</ExcludeApp_Data>
    <PublishUrl>bin\Publish\PrjFolder\</PublishUrl>
    <PublishDir>bin\Publish\PrjFolder\</PublishDir>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnvironmentName>Production</EnvironmentName>
  </PropertyGroup>
</Project>
